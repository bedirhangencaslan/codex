{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AnalyticsRequestPoint": {
      "description": "One request's billed shape, in file order.",
      "properties": {
        "cachedInputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "inputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "invisible": {
          "type": "boolean"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "cachedInputTokens",
        "inputTokens",
        "invisible",
        "sequence"
      ],
      "type": "object"
    },
    "ThreadAnalytics": {
      "properties": {
        "cachedInputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "inputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "invisibleRequests": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "lastTimestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "description": "From the sidecar header; `None` when the header line was unreadable.",
          "type": [
            "string",
            "null"
          ]
        },
        "outputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoningOutputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "requests": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "threadId": {
          "type": "string"
        },
        "timeline": {
          "items": {
            "$ref": "#/definitions/AnalyticsRequestPoint"
          },
          "type": "array"
        },
        "timelineTruncated": {
          "description": "True when the timeline was capped; the token sums above still cover every request in the file.",
          "type": "boolean"
        }
      },
      "required": [
        "cachedInputTokens",
        "inputTokens",
        "invisibleRequests",
        "outputTokens",
        "reasoningOutputTokens",
        "requests",
        "threadId",
        "timeline",
        "timelineTruncated"
      ],
      "type": "object"
    }
  },
  "properties": {
    "data": {
      "items": {
        "$ref": "#/definitions/ThreadAnalytics"
      },
      "type": "array"
    }
  },
  "required": [
    "data"
  ],
  "title": "AnalyticsThreadStatsResponse",
  "type": "object"
}