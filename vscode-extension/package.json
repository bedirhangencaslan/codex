{
  "name": "suffice-vscode",
  "displayName": "Suffice",
  "description": "%extension.description%",
  "version": "0.1.0",
  "private": true,
  "publisher": "suffice",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "suffice",
          "title": "%suffice.container%",
          "icon": "media/suffice.svg"
        }
      ]
    },
    "views": {
      "suffice": [
        {
          "type": "webview",
          "id": "suffice.chat",
          "name": "%suffice.view%"
        }
      ]
    },
    "commands": [
      {
        "command": "suffice.focus",
        "title": "%command.focus%"
      },
      {
        "command": "suffice.newThread",
        "title": "%command.newThread%"
      },
      {
        "command": "suffice.showInterfaces",
        "title": "%command.showInterfaces%"
      },
      {
        "command": "suffice.restartServer",
        "title": "%command.restartServer%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "suffice.binaryPath": {
          "type": "string",
          "default": "",
          "description": "%config.binaryPath%"
        },
        "suffice.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "tr"
          ],
          "default": "auto",
          "description": "%config.language%"
        },
        "suffice.theme": {
          "type": "string",
          "default": "vscode",
          "description": "%config.theme%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.18",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "1.90.0",
    "esbuild": "^0.28.1",
    "jest": "^29.7.0",
    "marked": "^15.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.4.4",
    "typescript": "^5.9.2"
  }
}
