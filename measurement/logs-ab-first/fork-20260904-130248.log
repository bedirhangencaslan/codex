 162: def main() -> None:
 163:     DB_PATH.unlink(missing_ok=True)
 164:     with sqlite3.connect(DB_PATH) as conn, open(SCHEMA_PATH, encoding="utf-8") as schema_file:
 165:         conn.row_factory = sqlite3.Row
 166:         conn.executescript(schema_file.read())
 167:         for restaurant in RESTAURANTS:
 168:             cursor = conn.execute(
 169:                 """INSERT INTO restaurant
 170:                    (name, cuisine, rating, delivery_fee, min_order, eta_minutes, image_emoji)
 171:                    VALUES (?, ?, ?, ?, ?, ?, ?)""",
 172:                 (
 173:                     restaurant["name"],
 174:                     restaurant["cuisine"],
 175:                     restaurant["rating"],
 176:                     restaurant["delivery_fee"],
 177:                     restaurant["min_order"],
 178:                     restaurant["eta_minutes"],
 179:                     restaurant["image_emoji"],
 180:                 ),
 181:             )
 182:             restaurant_id = cursor.lastrowid
 183:             conn.executemany(
 184:                 """INSERT INTO menu_item
 185:                    (restaurant_id, name, description, price, category)
 186:                    VALUES (?, ?, ?, ?, ?)""",
 187:                 [
