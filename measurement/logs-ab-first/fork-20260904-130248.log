api/main.py:142: @app.post("/api/orders", status_code=201)
api/main.py:143: def create_order(payload: OrderInput, user=Depends(require_customer)) -> dict[str, Any]:
api/main.py:144:     if not payload.items:
api/main.py:145:         raise HTTPException(status_code=400, detail="Siparis icin en az bir urun gerekli")
api/main.py:146:     if user and user["role"] != "customer":
api/main.py:147:         raise HTTPException(status_code=403, detail="Siparis icin musteri hesabi kullanin")
api/main.py:148: 
api/main.py:149:     with get_db() as conn:
api/main.py:150:         restaurant = conn.execute(
api/main.py:151:             "SELECT * FROM restaurant WHERE id = ?", (payload.restaurant_id,)
api/main.py:152:         ).fetchone()
api/main.py:153:         if not restaurant:
api/main.py:154:             raise HTTPException(status_code=404, detail="Restoran bulunamadi")
api/main.py:155: 
api/main.py:156:         placeholders = ",".join("?" for _ in payload.items)
api/main.py:157:         menu_rows = conn.execute(
api/main.py:158:             f"""SELECT id, name, price FROM menu_item
api/main.py:159:                 WHERE restaurant_id = ? AND id IN ({placeholders})""",
api/main.py:160:             [payload.restaurant_id, *[item.menu_item_id for item in payload.items]],
api/main.py:161:         ).fetchall()
api/main.py:162:         menu_by_id = {row["id"]: row for row in menu_rows}
api/main.py:163:         if len(menu_by_id) != len({item.menu_item_id for item in payload.items}):
api/main.py:164:             raise HTTPException(status_code=404, detail="Menu urunu bulunamadi")
api/main.py:165: 
api/main.py:166:         subtotal = sum(menu_by_id[item.menu_item_id]["price"] * item.quantity for item in payload.items)
api/main.py:167:         if subtotal < restaurant["min_order"]:
api/main.py:168:             missing = restaurant["min_order"] - subtotal
api/main.py:169:             raise HTTPException(
api/main.py:170:                 status_code=400,
api/main.py:171:                 detail=f"Minimum sepet tutarinin {missing:.2f} TL altindasiniz",
api/main.py:172:             )
api/main.py:173: 
api/main.py:174:         total = round(subtotal + restaurant["delivery_fee"], 2)
api/main.py:175:         missing_balance = round(max(0, total - user["balance"]), 2)
api/main.py:176:         if missing_balance > 0:
api/main.py:177:             raise HTTPException(
api/main.py:178:                 status_code=400,
api/main.py:179:                 detail=f"Bakiyeniz yetersiz. Siparis icin {missing_balance:.2f} TL daha yukleyin",
api/main.py:180:             )
api/main.py:181:         deducted = conn.execute(
api/main.py:182:             'UPDATE "user" SET balance = balance - ? WHERE id = ? AND balance >= ?',
api/main.py:183:             (total, user["id"], total),
api/main.py:184:         ).rowcount
api/main.py:185:         if not deducted:
api/main.py:186:             raise HTTPException(status_code=400, detail="Bakiye dusurulemedi")
api/main.py:187: 
api/main.py:188:         now = datetime.now(timezone.utc).isoformat()
api/main.py:189:         cursor = conn.execute(
api/main.py:190:             """INSERT INTO "order"
api/main.py:191:                (restaurant_id, address, phone, note, total, status, created_at, customer_id)
api/main.py:192:                VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
api/main.py:193:             (
api/main.py:194:                 payload.restaurant_id,
api/main.py:195:                 payload.address,
api/main.py:196:                 payload.phone,
api/main.py:197:                 payload.note,
api/main.py:198:                 total,
api/main.py:199:                 "hazÃ„Â±rlanÃ„Â±yor",
api/main.py:200:                 now,
api/main.py:201:                 user["id"],
api/main.py:202:             ),
api/main.py:203:         )
api/main.py:204:         order_id = cursor.lastrowid
api/main.py:205:         for item in payload.items:
api/main.py:206:             menu_item = menu_by_id[item.menu_item_id]
api/main.py:207:             conn.execute(
api/main.py:208:                 """INSERT INTO order_item
api/main.py:209:                    (order_id, menu_item_id, name, unit_price, quantity)
api/main.py:210:                    VALUES (?, ?, ?, ?, ?)""",
api/main.py:211:                 (order_id, item.menu_item_id, menu_item["name"], menu_item["price"], item.quantity),
api/main.py:212:             )
api/main.py:213: 
api/main.py:214:     return {"id": order_id, "status": "hazÃ„Â±rlanÃ„Â±yor", "total": total}
