   3: async function request<T>(path: string, options?: RequestInit): Promise<T> {
   4:   const stored = localStorage.getItem("sepet-auth");
   5:   const token = stored ? (JSON.parse(stored) as { token?: string }).token : undefined;
   6:   const response = await fetch(path, {
   7:     headers: {
   8:       ...(options?.body ? { "Content-Type": "application/json" } : {}),
   9:       ...(token ? { Authorization: `Bearer ${token}` } : {}),
  10:     },
  11:     ...options,
  12:   });
  13:   if (!response.ok) {
  14:     const message = await response
  15:       .json()
  16:       .then((data) => data?.detail)
  17:       .catch(() => undefined);
  18:     throw new Error(typeof message === "string" ? message : "Ã„Â°Ã…Å¸lem tamamlanamadÃ„Â±");
  19:   }
  20:   return response.json() as Promise<T>;
  21: }
  22: 
  23: export type RestaurantFilters = {
  24:   query: string;
  25:   cuisine: string;
  26:   minRating: number;
  27:   maxDeliveryFee: number;
  28:   maxEtaMinutes: number;
  29:   sort: "rating" | "eta" | "delivery_fee" | "min_order";
  30: };
  31: 
  32: export const fetchRestaurants = (filters: RestaurantFilters) => {
  33:   const params = new URLSearchParams();
  34:   if (filters.query) params.set("q", filters.query);
  35:   if (filters.cuisine) params.set("cuisine", filters.cuisine);
  36:   if (filters.minRating) params.set("min_rating", String(filters.minRating));
  37:   if (filters.maxDeliveryFee !== 999) params.set("max_delivery_fee", String(filters.maxDeliveryFee));
  38:   if (filters.maxEtaMinutes !== 999) params.set("max_eta_minutes", String(filters.maxEtaMinutes));
  39:   params.set("sort", filters.sort);
  40:   const suffix = params.size ? `?${params.toString()}` : "";
  41:   return request<Restaurant[]>(`/api/restaurants${suffix}`);
  42: };
  43: 
