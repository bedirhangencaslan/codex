 471:   .page-hero { flex-direction: column; align-items: flex-start; }
 472:   .hero-stats { width: 100%; }
 473:   .cart-panel.is-empty { margin-bottom: 70px; }
 474:   .detail-layout .cart-panel:not(.is-empty) { position: sticky; bottom: 0; z-index: 5; margin-top: 20px; border-top: 3px solid var(--orange); }
 475:   .restaurant-facts { display: grid; }
 476: }
 477: .stats-grid {
 478:   display: grid;
 479:   grid-template-columns: repeat(2, minmax(0, 1fr));
 480:   gap: 10px;
 481: }
 482: .stat-card,
 483: .wallet-card {
 484:   border: 1px solid var(--line);
 485:   border-radius: var(--radius);
 486:   background: var(--card);
 487:   box-shadow: var(--shadow);
 488: }
 489: .stat-card {
 490:   padding: 14px;
 491: }
 492: .stat-card span {
 493:   display: block;
 494:   margin-bottom: 4px;
 495:   color: var(--muted);
 496:   font-size: 13px;
 497:   font-weight: 800;
 498: }
 499: .stat-card strong {
 500:   font-size: 21px;
 501: }
 502: .wallet-card {
 503:   padding: 18px;
 504: }
 505: .wallet-head {
 506:   display: flex;
 507:   align-items: center;
 508:   justify-content: space-between;
 509:   gap: 16px;
 510: }
 511: .wallet-head h2 { font-size: 30px; }
 512: .wallet-icon {
 513:   display: grid;
 514:   place-items: center;
 515:   width: 48px;
 516:   height: 48px;
 517:   color: white;
 518:   background: var(--orange);
 519:   border-radius: var(--radius);
 520:   font-size: 22px;
 521:   font-weight: 900;
 522: }
 523: .wallet-form {
 524:   display: grid;
 525:   grid-template-columns: minmax(0, 1fr) auto;
 526:   align-items: end;
 527:   gap: 10px;
 528:   margin-top: 16px;
 529: }
 530: .wallet-form label { display: grid; gap: 5px; }
 531: .wallet-form span {
 532:   color: var(--muted);
 533:   font-size: 13px;
 534:   font-weight: 800;
 535: }
 536: .wallet-form button { white-space: nowrap; }
 537: .balance-pill {
 538:   display: inline-flex;
 539:   align-items: center;
 540:   min-height: 38px;
 541:   padding: 0 12px;
 542:   color: var(--orange-dark);
 543:   border: 1px solid #f0c3a8;
 544:   border-radius: 999px;
 545:   background: var(--orange-tint);
 546:   font-weight: 900;
 547:   white-space: nowrap;
 548: }
 549: .balance-line {
 550:   color: var(--orange-dark);
 551:   font-weight: 800;
 552: }
 553: .status.success {
 554:   color: var(--green);
 555:   background: var(--green-tint);
 556: }
 557: .status.warning {
 558:   color: #8a4b08;
 559:   background: #fff4df;
 560: }
 561: 
 562: @media (min-width: 720px) {
 563:   .stats-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
 564: }
 565: @media (max-width: 640px) {
 566:   .wallet-form { grid-template-columns: 1fr; }
 567:   .balance-pill { display: none; }
 568: }

