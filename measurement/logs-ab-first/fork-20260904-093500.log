  33: @app.get("/api/restaurants")
  34: def list_restaurants(q: str = "", cuisine: str = "", min_rating: float = 0.0, max_delivery_fee: float = 999.0, max_eta_minutes: int = 999, sort: str = "rating") -> list[dict[str, Any]]:
  35:     conditions = []
  36:     params: list[str] = []
  37:     if q:
  38:         conditions.append("(name LIKE ? OR cuisine LIKE ?)")
  39:         search = f"%{q.lower()}%"
  40:         params.extend([search, search])
  41:     if cuisine:
  42:         conditions.append("cuisine = ?")
  43:         params.append(cuisine.lower())
  44:     query = "SELECT * FROM restaurant"
  45:     if conditions:
  46:         query += " WHERE " + " AND ".join(conditions)
  47:     with get_db() as conn:
  48:         rows = conn.execute(query, params).fetchall()
  49:         review_stats = {
  50:             row["restaurant_id"]: row["avg_rating"]
  51:             for row in conn.execute(
  52:                 "SELECT restaurant_id, AVG(rating) AS avg_rating FROM restaurant_review GROUP BY restaurant_id"
  53:             ).fetchall()
  54:         }
  55:         result = []
  56:         for row in rows:
  57:             item = dict(row)
  58:             if row["id"] in review_stats:
  59:                 item["rating"] = displayed_rating(
  60:                     row["rating"], [{"rating": review_stats[row["id"]]}]
  61:                 )
  62:             result.append(item)
  63:     result = [item for item in result if item["rating"] >= min_rating and item["delivery_fee"] <= max_delivery_fee and item["eta_minutes"] <= max_eta_minutes]
  64:     sorters = {
  65:         "rating": lambda item: item["rating"],
  66:         "eta": lambda item: item["eta_minutes"],
  67:         "delivery_fee": lambda item: item["delivery_fee"],
  68:         "min_order": lambda item: item["min_order"],
  69:     }
  70:     return sorted(result, key=sorters.get(sort, sorters["rating"]))
