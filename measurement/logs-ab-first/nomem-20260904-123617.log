 162: def main() -> None:
 163:     DB_PATH.unlink(missing_ok=True)
 164:     with sqlite3.connect(DB_PATH) as conn, open(SCHEMA_PATH, encoding="utf-8") as schema_file:
 165:         conn.row_factory = sqlite3.Row
 166:         conn.executescript(schema_file.read())
 167:         for restaurant in RESTAURANTS:
 168:             cursor = conn.execute(
 169:                 """INSERT INTO restaurant
 170:                    (name, cuisine, rating, delivery_fee, min_order, eta_minutes, image_emoji)
 171:                    VALUES (?, ?, ?, ?, ?, ?, ?)""",
 172:                 (
 173:                     restaurant["name"],
 174:                     restaurant["cuisine"],
 175:                     restaurant["rating"],
 176:                     restaurant["delivery_fee"],
 177:                     restaurant["min_order"],
 178:                     restaurant["eta_minutes"],
 179:                     restaurant["image_emoji"],
 180:                 ),
 181:             )
 182:             restaurant_id = cursor.lastrowid
 183:             conn.executemany(
 184:                 """INSERT INTO menu_item
 185:                    (restaurant_id, name, description, price, category)
 186:                    VALUES (?, ?, ?, ?, ?)""",
 187:                 [
 188:                     (restaurant_id, item[0], item[1], item[2], item[3])
 189:                     for item in restaurant["menu"]
 190:                 ],
 191:             )
 192: 
 193:         password_hash = hash_password("sepet123")
 194:         now = utc_now()
 195:         customer_cursor = conn.execute(
 196:             'INSERT INTO "user" (email, password_hash, role, balance) VALUES (?, ?, ?, ?)',
 197:             ("musteri@sepet.test", password_hash, "customer", 250.0),
 198:         )
 199: 
 200:         for restaurant, slug in zip(RESTAURANTS, RESTAURANT_SLUGS):
 201:             row = conn.execute(
 202:                 "SELECT id FROM restaurant WHERE name = ?", (restaurant["name"],)
 203:             ).fetchone()
 204:             if not row:
 205:                 continue
 206:             restaurant_id = row["id"]
 207:             owner_cursor = conn.execute(
 208:                 'INSERT INTO "user" (email, password_hash, role, balance) VALUES (?, ?, ?, ?)',
 209:                 (f"sahip.{slug}@sepet.test", password_hash, "restaurant", 0.0),
 210:             )
 211:             conn.execute(
 212:                 "UPDATE restaurant SET user_id = ? WHERE id = ?",
 213:                 (owner_cursor.lastrowid, restaurant_id),
 214:             )
 215:             for number in (1, 2):
 216:                 courier_user = conn.execute(
 217:                     'INSERT INTO "user" (email, password_hash, role, balance) VALUES (?, ?, ?, ?)',
 218:                     (f"kurye{number}.{slug}@sepet.test", password_hash, "courier", 0.0),
 219:                 )
 220:                 conn.execute(
 221:                     "INSERT INTO courier (user_id, restaurant_id, name) VALUES (?, ?, ?)",
 222:                     (
 223:                         courier_user.lastrowid,
 224:                         restaurant_id,
 225:                         f"{restaurant['name']} Kurye {number}",
 226:                     ),
 227:                 )
 228: 
 229:         print("Demo musteri: musteri@sepet.test / sepet123")
 230:         print(f"{len(RESTAURANTS)} restoran ve veritabani olusturuldu: {DB_PATH}")
