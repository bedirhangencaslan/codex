 104:               </div>
 105:               <div className="order-actions">
 106:                 <Link className="link-button" to={`/order/${order.id}`}>Detay</Link>
 107:                 {order.status === "teslim_edildi" && (
 108:                   <button className="secondary-button" onClick={() => confirm(order.id)}>Teslimi onayla</button>
 109:                 )}
 110:               </div>
 111:             </article>
 112:           ))}
 113:         </div>
 114:       )}
 115:     </div>
 116:   );
 117: }
