  70:           <label>Adres<textarea value={address} onChange={(event) => setAddress(event.target.value)} placeholder="Mahalle, sokak, bina ve daire" required /></label>
  71:           <label>Telefon<input value={phone} onChange={(event) => setPhone(event.target.value)} inputMode="tel" placeholder="5xx xxx xx xx" required /></label>
  72:           <label>Sipariş notu<textarea value={note} onChange={(event) => setNote(event.target.value)} placeholder="Kapı kodu, kat bilgisi veya özel istek" /></label>
  73:           {error && <p className="status error">{error}</p>}
  74:           <button className="primary-button" disabled={sending || !user || missingBalance > 0}>
  75:             {sending ? "Gönderiliyor..." : "Siparişi onayla"}
