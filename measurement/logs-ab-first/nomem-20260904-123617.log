  51: export const createOrder = (restaurantId: number, address: string, phone: string, note: string, items: CartLine[]) =>
  52:   request<{ id: number }>("/api/orders", {
  53:     method: "POST",
  54:     body: JSON.stringify({
  55:       restaurant_id: restaurantId,
  56:       address,
  57:       phone,
  58:       note,
  59:       items: items.map((line) => {
  60:         const input: Pick<OrderItem, "menu_item_id" | "quantity"> = {
  61:           menu_item_id: line.item.id,
  62:           quantity: line.quantity,
  63:         };
  64:         return input;
  65:       }),
  66:     }),
  67:   });
