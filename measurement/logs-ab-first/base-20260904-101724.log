  64:             <span>{restaurant.eta_minutes} dk</span>
  65:             <span>Teslimat {formatTL(restaurant.delivery_fee)}</span>
  66:             <span>Min. {formatTL(restaurant.min_order)}</span>
  67:           </div>
  68:         </div>
  69:       </div>
  70: 
  71:       <div className="detail-layout">
  72:         <div className="menu-list">
  73:           {groupedMenu.map(([category, items]) => (
  74:             <div key={category} className="menu-group">
