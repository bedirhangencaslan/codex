 120:     with get_db() as conn:
 121:         rows = conn.execute(
 122:             "SELECT * FROM menu_item WHERE restaurant_id = ? ORDER BY category, name",
 123:             (restaurant["id"],),
 124:         ).fetchall()
 125:     return [dict(row) for row in rows]
