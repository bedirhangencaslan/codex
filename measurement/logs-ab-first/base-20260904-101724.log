  41       const approved = window.confirm("Farklı restorandan ürün eklediniz. Sepet boşaltılacak.");
  42       if (!approved) return;
  43       cart.clear();
  44     }
  45     cart.add(item, restaurant?.delivery_fee ?? 0);
  46   }
  47 
  48   if (loading) return <div className="status">Menü yükleniyor...</div>;
  49   if (error) return <div className="status error">{error}</div>;
  50   if (!restaurant) return null;
