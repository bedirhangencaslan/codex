  23         setError("");
  24       })
  25       .catch(() => setError("Restoran yüklenemedi"))
  26       .finally(() => setLoading(false));
  27   }, [id]);
  28 
  29   const groupedMenu = useMemo(() => {
  30     const groups = new Map<string, MenuItem[]>();
  31     restaurant?.menu_items?.forEach((item) => {
  32       const existing = groups.get(item.category) ?? [];
  33       existing.push(item);
  34       groups.set(item.category, existing);
  35     });
  36     return [...groups.entries()];
  37   }, [restaurant]);
  38 
  39   function addToCart(item: MenuItem) {
