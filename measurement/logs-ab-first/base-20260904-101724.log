 114:                   Puan
 115:                   <select value={reviewRating} onChange={(event) => setReviewRating(Number(event.target.value))}>
 116:                     {[5, 4, 3, 2, 1].map((rating) => <option key={rating} value={rating}>{rating} yıldız</option>)}
 117:                   </select>
 118:                 </label>
 119:                 <label>
 120:                   Yorum
 121:                   <textarea
 122:                     value={reviewComment}
 123:                     onChange={(event) => setReviewComment(event.target.value)}
 124:                     placeholder="Yemek ve teslimat deneyimini kısaca anlat."
 125:                     required
 126:                   />
 127:                 </label>
 128:                 <button className="primary-button">Yorumu gönder</button>
 129:               </form>
 130:             )}
 131:           </section>
 132:         </div>
 133: 
 134:         <aside className={cartEmpty ? "cart-panel is-empty" : "cart-panel"}>
 135:           <h2>Sepetin</h2>
 136:           {cartEmpty ? (
 137:             <p>Sepet şu an boş. Menüden ekleyeceğin ürünler burada görünecek.</p>
 138:           ) : (
 139:             <>
 140:               {ownCart?.lines.map((line) => (
 141:                 <div key={line.item.id} className="cart-line">
 142:                   <span>{line.item.name}</span>
 143:                   <div className="quantity">
 144:                     <button onClick={() => cart.change(line.item.id, -1)} aria-label="Azalt">-</button>
