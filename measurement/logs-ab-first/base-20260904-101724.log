 154:             raise HTTPException(status_code=404, detail="Restoran bulunamadi")
 155: 
 156:         placeholders = ",".join("?" for _ in payload.items)
 157:         menu_rows = conn.execute(
 158:             f"""SELECT id, name, price FROM menu_item
 159:                 WHERE restaurant_id = ? AND id IN ({placeholders})""",
