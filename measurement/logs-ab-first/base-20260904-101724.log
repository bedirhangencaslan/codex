sepet/api/panels.py:247: @router.get("/restaurant/earnings")
sepet/api/panels.py:248: def restaurant_earnings(user_restaurant=Depends(require_restaurant)) -> dict[str, Any]:
sepet/api/panels.py:249:     _, restaurant = user_restaurant
sepet/api/panels.py:250:     with get_db() as conn:
sepet/api/panels.py:251:         overall = conn.execute(
sepet/api/panels.py:252:             """SELECT COUNT(*) AS order_count,
sepet/api/panels.py:253:                       COALESCE(SUM(total), 0) AS revenue
sepet/api/panels.py:254:                FROM "order" WHERE restaurant_id = ?""",
sepet/api/panels.py:255:             (restaurant["id"],),
sepet/api/panels.py:256:         ).fetchone()
sepet/api/panels.py:257:         confirmed = conn.execute(
sepet/api/panels.py:258:             """SELECT COUNT(*) AS order_count,
sepet/api/panels.py:259:                       COALESCE(SUM(total), 0) AS revenue
sepet/api/panels.py:260:                FROM "order"
sepet/api/panels.py:261:                WHERE restaurant_id = ? AND status = 'onayland\u0131'""",
sepet/api/panels.py:262:             (restaurant["id"],),
sepet/api/panels.py:263:         ).fetchone()
sepet/api/panels.py:264:     average = round(overall["revenue"] / overall["order_count"], 2) if overall["order_count"] else 0
sepet/api/panels.py:265:     return {
sepet/api/panels.py:266:         "total_revenue": round(overall["revenue"], 2),
sepet/api/panels.py:267:         "confirmed_revenue": round(confirmed["revenue"], 2),
sepet/api/panels.py:268:         "pending_revenue": round(overall["revenue"] - confirmed["revenue"], 2),
sepet/api/panels.py:269:         "order_count": overall["order_count"],
sepet/api/panels.py:270:         "confirmed_order_count": confirmed["order_count"],
sepet/api/panels.py:271:         "average_order_value": average,
sepet/api/panels.py:272:     }
