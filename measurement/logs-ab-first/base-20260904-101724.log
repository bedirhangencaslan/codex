 147:                   </div>
 148:                   <strong>{formatTL(line.item.price * line.quantity)}</strong>
 149:                 </div>
 150:               ))}
 151:               <div className="totals"><span>Ara toplam</span><span>{formatTL(cart.subtotal)}</span></div>
 152:               <div className="totals"><span>Teslimat</span><span>{formatTL(restaurant.delivery_fee)}</span></div>
 153:               <div className="totals strong"><span>Toplam</span><span>{formatTL(cart.subtotal + restaurant.delivery_fee)}</span></div>
 154:               {cart.subtotal < restaurant.min_order && (
 155:                 <p className="warning">
 156:                   Minimum sepet için {formatTL(restaurant.min_order - cart.subtotal)} daha ekleyin.
 157:                 </p>
 158:               )}
 159:               <Link className="primary-button" to="/checkout" state={{ deliveryFee: restaurant.delivery_fee }}>
 160:                 Sepeti onayla
 161:               </Link>
 162:             </>
 163:           )}
 164:         </aside>
 165:       </div>
 166:     </section>
 167:   );
 168: }
