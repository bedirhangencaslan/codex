 138           ) : (
 139             <>
 140               {ownCart?.lines.map((line) => (
 141                 <div key={line.item.id} className="cart-line">
 142                   <span>{line.item.name}</span>
 143                   <div className="quantity">
 144                     <button onClick={() => cart.change(line.item.id, -1)} aria-label="Azalt">-</button>
 145                     <span>{line.quantity}</span>
 146                     <button onClick={() => cart.change(line.item.id, 1)} aria-label="Arttır">+</button>
 147                   </div>
 148                   <strong>{formatTL(line.item.price * line.quantity)}</strong>
 149                 </div>
 150               ))}
 151               <div className="totals"><span>Ara toplam</span><span>{formatTL(cart.subtotal)}</span></div>
