   1 import { FormEvent, useState } from "react";
   2 import { Link, useLocation, useNavigate } from "react-router-dom";
   3 import { createOrder } from "../api";
   4 import { useAuth } from "../AuthContext";
   5 import { useCart } from "../CartContext";
   6 
   7 const formatTL = (value: number) => `${value.toFixed(2)} TL`;
   8 
   9 export default function Checkout() {
  10   const cart = useCart();
  11   const { user } = useAuth();
  12   const navigate = useNavigate();
  13   const location = useLocation();
  14   const deliveryFee = (location.state?.deliveryFee as number | undefined) ?? cart.lines[0]?.deliveryFee ?? 0;
  15   const [address, setAddress] = useState("");
  16   const [phone, setPhone] = useState("");
  17   const [note, setNote] = useState("");
  18   const [error, setError] = useState("");
  19   const [sending, setSending] = useState(false);
  20   const total = cart.subtotal + deliveryFee;
  21   const missingBalance = Math.max(0, total - (user?.balance ?? 0));
  22 
  23   if (!cart.lines.length) {
  24     return (
  25       <div className="empty-state">
  26         <strong>Sepetiniz boş</strong>
  27         <p>Sipariş vermek için bir restoran seçip menüden ürün ekleyin.</p>
  28         <Link className="secondary-button" to="/">Restoranlara dön</Link>
  29       </div>
  30     );
  31   }
  32 
  33   async function submit(event: FormEvent) {
  34     event.preventDefault();
  35     const digits = phone.replace(/\D/g, "");
  36     if (address.trim().length < 10) {
  37       setError("Adres en az 10 karakter olmalıdır.");
  38       return;
  39     }
  40     if (digits.length < 10 || digits.length > 11) {
  41       setError("Telefon 10-11 hane olmalıdır.");
  42       return;
  43     }
  44     setSending(true);
  45     setError("");
  46     try {
  47       const result = await createOrder(cart.restaurantId!, address, digits, note, cart.lines);
  48       cart.clear();
  49       navigate(`/order/${result.id}`);
  50     } catch (requestError) {
  51       setError(requestError instanceof Error ? requestError.message : "Sipariş gönderilemedi");
  52     } finally {
  53       setSending(false);
  54     }
  55   }
  56 
  57   return (
  58     <section className="page-section">
  59       <div className="section-head">
  60         <h1>Teslimat</h1>
  61         <p>Siparişin doğru adrese gitsin.</p>
  62       </div>
  63       <div className="checkout-layout">
  64         <form onSubmit={submit} className="form-card">
  65           {!user && (
  66             <div className="status warning">
  67               Sipariş için giriş yapmalısınız. <Link className="link-button" to="/giris">Giriş yap</Link>
  68             </div>
  69           )}
  70           <label>Adres<textarea value={address} onChange={(event) => setAddress(event.target.value)} placeholder="Mahalle, sokak, bina ve daire" required /></label>
  71           <label>Telefon<input value={phone} onChange={(event) => setPhone(event.target.value)} inputMode="tel" placeholder="5xx xxx xx xx" required /></label>
  72           <label>Sipariş notu<textarea value={note} onChange={(event) => setNote(event.target.value)} placeholder="Kapı kodu, kat bilgisi veya özel istek" /></label>
  73           {error && <p className="status error">{error}</p>}
  74           <button className="primary-button" disabled={sending || !user || missingBalance > 0}>
  75             {sending ? "Gönderiliyor..." : "Siparişi onayla"}
  76           </button>
  77         </form>
  78         <aside className="cart-panel">
  79           <h2>Sipariş özeti</h2>
  80           {cart.lines.map((line) => (
  81             <div key={line.item.id} className="cart-line compact">
  82               <span>{line.item.name}</span>
  83               <strong>{formatTL(line.item.price * line.quantity)}</strong>
  84             </div>
  85           ))}
  86           <div className="totals"><span>Ara toplam</span><span>{formatTL(cart.subtotal)}</span></div>
  87           <div className="totals"><span>Teslimat</span><span>{formatTL(deliveryFee)}</span></div>
  88           <div className="totals strong"><span>Toplam</span><span>{formatTL(total)}</span></div>
  89           {user && typeof user.balance === "number" && (
  90             <div className="totals balance-line"><span>Bakiyeniz</span><span>{formatTL(user.balance)}</span></div>
  91           )}
  92           {missingBalance > 0 && (
  93             <div className="status warning">
  94               Bakiyeniz {formatTL(missingBalance)} eksik. <Link className="link-button" to="/panel">Bakiye yükle</Link>
  95             </div>
  96           )}
  97         </aside>
  98       </div>
  99     </section>
 100   );
 101 }

