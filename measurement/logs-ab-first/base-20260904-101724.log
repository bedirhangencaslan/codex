  64             <span>{restaurant.eta_minutes} dk</span>
  65             <span>Teslimat {formatTL(restaurant.delivery_fee)}</span>
  66             <span>Min. {formatTL(restaurant.min_order)}</span>
  67           </div>
  68         </div>
  69       </div>
  70 
  71       <div className="detail-layout">
  72         <div className="menu-list">
  73           {groupedMenu.map(([category, items]) => (
  74             <div key={category} className="menu-group">
  75               <h2>{category}</h2>
  76               {items.map((item) => (
  77                 <article key={item.id} className="menu-card">
  78                   <div className="menu-copy">
  79                     <h3>{item.name}</h3>
  80                     <p>{item.description}</p>
  81                     <strong>{formatTL(item.price)}</strong>
  82                   </div>
  83                   <button onClick={() => addToCart(item)}>Ekle</button>
  84                 </article>
  85               ))}
  86             </div>
  87           ))}
  88 
  89           <section className="review-section">
  90             <h2>Yorumlar</h2>
  91             {!restaurant.reviews?.length && <div className="status">Henüz yorum yok.</div>}
  92             {restaurant.reviews?.map((review) => (
  93               <article key={review.id} className="review-card">
  94                 <div className="review-head">
  95                   <strong>{review.user_email}</strong>
  96                   <span className="rating">{review.rating}.0</span>
  97                 </div>
  98                 <p>{review.comment}</p>
  99               </article>
 100             ))}
 101             {restaurant.can_review && !restaurant.has_review && (
 102               <form
 103                 className="review-form"
 104                 onSubmit={async (event) => {
 105                   event.preventDefault();
 106                   await submitReview(restaurant.id, reviewRating, reviewComment);
 107                   const updated = await fetchRestaurant(restaurant.id);
 108                   setRestaurant(updated);
 109                   setReviewComment("");
 110                 }}
 111               >
 112                 <h3>Değerlendirme yap</h3>
 113                 <label>
 114                   Puan
 115                   <select value={reviewRating} onChange={(event) => setReviewRating(Number(event.target.value))}>
 116                     {[5, 4, 3, 2, 1].map((rating) => <option key={rating} value={rating}>{rating} yıldız</option>)}
 117                   </select>
 118                 </label>
 119                 <label>
 120                   Yorum
 121                   <textarea
 122                     value={reviewComment}
 123                     onChange={(event) => setReviewComment(event.target.value)}
 124                     placeholder="Yemek ve teslimat deneyimini kısaca anlat."
 125                     required
 126                   />
 127                 </label>
 128                 <button className="primary-button">Yorumu gönder</button>
 129               </form>
 130             )}
 131           </section>
 132         </div>
 133 
 134         <aside className={cartEmpty ? "cart-panel is-empty" : "cart-panel"}>
