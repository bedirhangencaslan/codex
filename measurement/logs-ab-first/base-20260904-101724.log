  96:                   <span className="rating">{review.rating}.0</span>
  97:                 </div>
  98:                 <p>{review.comment}</p>
  99:               </article>
 100:             ))}
 101:             {restaurant.can_review && !restaurant.has_review && (
 102:               <form
 103:                 className="review-form"
 104:                 onSubmit={async (event) => {
 105:                   event.preventDefault();
