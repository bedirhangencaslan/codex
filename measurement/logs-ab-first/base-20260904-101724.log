  81:                     <strong>{formatTL(item.price)}</strong>
  82:                   </div>
  83:                   <button onClick={() => addToCart(item)}>Ekle</button>
  84:                 </article>
  85:               ))}
  86:             </div>
  87:           ))}
  88: 
  89:           <section className="review-section">
  90:             <h2>Yorumlar</h2>
  91:             {!restaurant.reviews?.length && <div className="status">Henüz yorum yok.</div>}
  92:             {restaurant.reviews?.map((review) => (
  93:               <article key={review.id} className="review-card">
  94:                 <div className="review-head">
