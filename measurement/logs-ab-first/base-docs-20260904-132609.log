  35: def serialize_orders(conn, rows) -> list[dict[str, Any]]:
  36:     result = []
  37:     for row in rows:
  38:         order = dict(row)
  39:         order["items"] = [
  40:             dict(item)
  41:             for item in conn.execute(
  42:                 """SELECT id, menu_item_id, name, unit_price, quantity,
  43:                           unit_price * quantity AS line_total
  44:                    FROM order_item WHERE order_id = ? ORDER BY id""",
  45:                 (order["id"],),
  46:             ).fetchall()
  47:         ]
  48:         result.append(order)
  49:     return result
