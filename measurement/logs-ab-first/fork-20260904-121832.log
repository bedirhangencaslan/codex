 361: }
 362: .cart-line strong { white-space: nowrap; }
 363: .cart-line.with-controls { grid-template-columns: minmax(0, 1fr) auto auto; }
 364: .quantity { display: grid; grid-template-columns: 32px 28px 32px; align-items: center; justify-items: center; }
 365: .quantity button {
 366:   width: 32px; height: 32px;
 367:   border: 1px solid var(--line);
 368:   border-radius: 6px;
 369:   background: white;
 370:   font-weight: 900;
 371:   cursor: pointer;
 372: }
 373: .totals { display: flex; justify-content: space-between; margin-top: 8px; color: var(--muted); }
 374: .totals.strong, .totals.strong span { color: var(--ink); font-weight: 900; }
 375: .warning { margin-top: 12px; padding: 10px 12px; border-radius: var(--radius); color: #8b5300; background: #fff6df; }
 376: 
 377: .form-card {
 378:   display: grid;
 379:   gap: 14px;
 380:   padding: 20px;
 381:   border: 1px solid var(--line);
 382:   border-radius: var(--radius);
 383:   background: white;
 384:   box-shadow: var(--shadow);
 385: }
 386: label { display: grid; gap: 6px; font-weight: 800; }
 387: .checkout-layout, .order-layout, .account-layout {
 388:   display: grid;
 389:   grid-template-columns: 1fr;
 390:   gap: 20px;
 391:   align-items: start;
 392: }
 393: .nested-form { display: grid; gap: 10px; }
 394: .demo-accounts {
 395:   display: grid;
 396:   gap: 4px;
 397:   color: var(--muted);
 398:   font-size: 13px;
 399: }
 400: 
 401: .success-box {
 402:   padding: 20px;
 403:   border: 1px solid #bfe2d1;
 404:   border-radius: var(--radius);
 405:   background: var(--green-tint);
 406: }
 407: .success-box p { margin-top: 8px; }
 408: .order-items { display: grid; gap: 0; margin-top: 6px; }
 409: 
 410: .panel-head { display: flex; justify-content: space-between; align-items: center; gap: 14px; }
 411: .panel-body { display: grid; gap: 16px; }
 412: .tabs { display: flex; gap: 8px; overflow: auto hidden; scrollbar-width: none; }
 413: .tabs::-webkit-scrollbar { display: none; }
 414: .tabs button {
 415:   min-height: 38px;
 416:   padding: 0 16px;
 417:   border: 1px solid var(--line);
 418:   border-radius: var(--radius);
 419:   background: white;
 420:   color: var(--muted);
 421:   font-weight: 900;
 422:   cursor: pointer;
 423: }
 424: .tabs button.active { color: white; border-color: var(--orange); background: var(--orange); }
 425: .panel-list { display: grid; gap: 10px; }
 426: .panel-card {
 427:   padding: 16px;
 428:   border: 1px solid var(--line);
 429:   border-radius: var(--radius);
 430:   background: white;
 431:   box-shadow: var(--shadow);
 432: }
 433: .order-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
 434: .status-pill {
 435:   padding: 4px 10px;
 436:   border-radius: 999px;
 437:   color: var(--orange-dark);
 438:   background: var(--orange-tint);
 439:   font-size: 13px;
 440:   font-weight: 900;
 441: }
 442: .order-meta { display: flex; justify-content: space-between; gap: 10px; margin: 8px 0; color: var(--muted); }
 443: .order-items { display: flex; flex-direction: column; gap: 3px; color: var(--muted); font-size: 14px; }
 444: .order-actions { display: flex; justify-content: flex-end; align-items: center; gap: 10px; margin-top: 10px; }
 445: .assign-field { margin-top: 12px; }
 446: 
 447: .review-section { display: grid; gap: 10px; margin-top: 26px; }
 448: .review-card { padding: 14px; border: 1px solid var(--line); border-radius: var(--radius); background: white; }
 449: .review-head { display: flex; justify-content: space-between; gap: 10px; margin-bottom: 6px; }
 450: .review-card p { color: var(--muted); }
 451: .review-form { display: grid; gap: 12px; padding: 16px; border: 1px solid var(--line); border-radius: var(--radius); background: white; }
 452: 
 453: @media (min-width: 700px) {
 454:   .restaurant-grid { grid-template-columns: repeat(2, 1fr); }
 455:   .filter-bar { grid-template-columns: minmax(220px, 1fr) repeat(4, minmax(130px, 1fr)); }
 456: }
 457: @media (min-width: 900px) {
 458:   .header-inner, .page { width: min(1180px, 100% - 48px); }
 459:   .detail-layout, .checkout-layout, .order-layout, .account-layout { grid-template-columns: minmax(0, 1fr) 340px; }
 460:   .restaurant-grid { grid-template-columns: repeat(2, 1fr); }
 461:   .page-hero { padding: 26px; }
 462:   .cart-panel { position: sticky; top: 82px; }
 463:   .restaurant-hero-body { display: flex; align-items: center; justify-content: space-between; flex: 1; gap: 20px; flex-wrap: wrap; }
 464:   .restaurant-hero-body h1 { margin-bottom: 4px; }
 465: }
 466: @media (max-width: 699px) {
 467:   .header-inner { width: 100%; padding: 0 16px; }
 468:   .page { width: 100%; padding-inline: 16px; }
 469:   .brand { font-size: 18px; }
 470:   .nav-link { padding: 0 10px; }
 471:   .page-hero { flex-direction: column; align-items: flex-start; }
 472:   .hero-stats { width: 100%; }
 473:   .cart-panel.is-empty { margin-bottom: 70px; }
 474:   .detail-layout .cart-panel:not(.is-empty) { position: sticky; bottom: 0; z-index: 5; margin-top: 20px; border-top: 3px solid var(--orange); }
 475:   .restaurant-facts { display: grid; }
 476: }
 477: .stats-grid {
 478:   display: grid;
 479:   grid-template-columns: repeat(2, minmax(0, 1fr));
 480:   gap: 10px;
 481: }
 482: .stat-card,
 483: .wallet-card {
 484:   border: 1px solid var(--line);
 485:   border-radius: var(--radius);
 486:   background: var(--card);
 487:   box-shadow: var(--shadow);
 488: }
 489: .stat-card {
 490:   padding: 14px;
 491: }
 492: .stat-card span {
 493:   display: block;
 494:   margin-bottom: 4px;
 495:   color: var(--muted);
 496:   font-size: 13px;
 497:   font-weight: 800;
 498: }
 499: .stat-card strong {
 500:   font-size: 21px;
 501: }
 502: .wallet-card {
 503:   padding: 18px;
 504: }
 505: .wallet-head {
 506:   display: flex;
 507:   align-items: center;
 508:   justify-content: space-between;
 509:   gap: 16px;
 510: }
 511: .wallet-head h2 { font-size: 30px; }
 512: .wallet-icon {
 513:   display: grid;
 514:   place-items: center;
 515:   width: 48px;
 516:   height: 48px;
 517:   color: white;
 518:   background: var(--orange);
 519:   border-radius: var(--radius);
 520:   font-size: 22px;
 521:   font-weight: 900;
 522: }
 523: .wallet-form {
 524:   display: grid;
 525:   grid-template-columns: minmax(0, 1fr) auto;
 526:   align-items: end;
 527:   gap: 10px;
 528:   margin-top: 16px;
 529: }
 530: .wallet-form label { display: grid; gap: 5px; }
 531: .wallet-form span {
 532:   color: var(--muted);
 533:   font-size: 13px;
 534:   font-weight: 800;
 535: }
 536: .wallet-form button { white-space: nowrap; }
 537: .balance-pill {
 538:   display: inline-flex;
 539:   align-items: center;
 540:   min-height: 38px;
 541:   padding: 0 12px;
 542:   color: var(--orange-dark);
 543:   border: 1px solid #f0c3a8;
 544:   border-radius: 999px;
 545:   background: var(--orange-tint);
 546:   font-weight: 900;
 547:   white-space: nowrap;
 548: }
 549: .balance-line {
 550:   color: var(--orange-dark);
 551:   font-weight: 800;
 552: }
 553: .status.success {
 554:   color: var(--green);
 555:   background: var(--green-tint);
 556: }
 557: .status.warning {
 558:   color: #8a4b08;
 559:   background: #fff4df;
 560: }
 561: 
 562: @media (min-width: 720px) {
 563:   .stats-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
 564: }
 565: @media (max-width: 640px) {
 566:   .wallet-form { grid-template-columns: 1fr; }
 567:   .balance-pill { display: none; }
 568: }

