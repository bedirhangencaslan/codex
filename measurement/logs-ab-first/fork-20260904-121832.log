   1: import { createContext, useCallback, useContext, useEffect, useMemo, useState, type ReactNode } from "react";
   2: import type { CartLine, MenuItem } from "./types";
   3: 
   4: type CartState = {
   5:   lines: CartLine[];
   6:   restaurantId: number | null;
   7:   subtotal: number;
   8:   add: (item: MenuItem, deliveryFee: number) => void;
   9:   change: (itemId: number, delta: number) => void;
  10:   clear: () => void;
  11: };
  12: 
  13: const CartContext = createContext<CartState | null>(null);
  14: const STORAGE_KEY = "sepet-cart-v1";
  15: 
  16: type StoredCart = {
  17:   restaurantId: number | null;
  18:   lines: CartLine[];
  19: };
  20: 
  21: export function CartProvider({ children }: { children: ReactNode }) {
  22:   const [cart, setCart] = useState<StoredCart>(() => {
  23:     try {
  24:       const stored = localStorage.getItem(STORAGE_KEY);
  25:       return stored ? JSON.parse(stored) as StoredCart : { restaurantId: null, lines: [] };
  26:     } catch {
  27:       return { restaurantId: null, lines: [] };
  28:     }
  29:   });
  30: 
  31:   useEffect(() => {
  32:     localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
  33:   }, [cart]);
  34: 
  35:   const add = useCallback((item: MenuItem, deliveryFee: number) => {
  36:     setCart((current) => {
  37:       if (!current.restaurantId || current.restaurantId !== item.restaurant_id) {
  38:         return { restaurantId: item.restaurant_id, lines: [{ item, quantity: 1, deliveryFee }] };
  39:       }
  40:       const lines = current.lines.map((line) =>
  41:         line.item.id === item.id ? { ...line, quantity: line.quantity + 1 } : line,
  42:       );
  43:       if (!lines.some((line) => line.item.id === item.id)) {
  44:       lines.push({ item, quantity: 1, deliveryFee });
  45:       }
  46:       return { ...current, lines };
  47:     });
  48:   }, []);
  49: 
  50:   const change = useCallback((itemId: number, delta: number) => {
  51:     setCart((current) => {
  52:       const lines = current.lines
  53:         .map((line) => line.item.id === itemId ? { ...line, quantity: line.quantity + delta } : line)
  54:         .filter((line) => line.quantity > 0);
  55:       return lines.length ? { ...current, lines } : { restaurantId: null, lines: [] };
  56:     });
  57:   }, []);
  58: 
  59:   const clear = useCallback(() => setCart({ restaurantId: null, lines: [] }), []);
  60: 
  61:   const value = useMemo<CartState>(() => {
  62:     const subtotal = cart.lines.reduce((sum, line) => sum + line.item.price * line.quantity, 0);
  63:     return {
  64:       lines: cart.lines,
  65:       restaurantId: cart.restaurantId,
  66:       subtotal,
  67:       add,
  68:       change,
  69:       clear,
  70:     };
  71:   }, [add, cart, change, clear]);
  72: 
  73:   return <CartContext.Provider value={value}>{children}</CartContext.Provider>;
  74: }
  75: 
  76: export function useCart() {
  77:   const context = useContext(CartContext);
  78:   if (!context) throw new Error("useCart CartProvider icinde kullanilmali");
  79:   return context;
  80: }
