  140: /// Derives a stable ID for a prompt-only output from its source call's item ID.
  141: ///
  142: /// Prompt normalization can run repeatedly without persisting its synthetic
  143: /// outputs, so the namespace and name format must remain stable across retries
  144: /// and resumes to preserve prompt-cache reuse. Returning `None` when the source
  145: /// call has no ID preserves the legacy behavior for older history items.
  146: fn synthetic_output_id(prefix: &str, item_id: Option<&str>) -> Option<ResponseItemId> {
  147:     let source_id = item_id.filter(|id| !id.is_empty())?;
  148:     let name = format!("{prefix}:{source_id}");
  149:     Some(ResponseItemId::with_suffix(
  150:         prefix,
  151:         Uuid::new_v5(&SYNTHETIC_OUTPUT_ID_NAMESPACE, name.as_bytes()),
  152:     ))
  153: }
