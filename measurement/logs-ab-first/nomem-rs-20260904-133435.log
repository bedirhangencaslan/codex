  244: fn program_is_shrinkable(words: &[String]) -> bool {
  245:     let mut words = words.iter().map(String::as_str).peekable();
  246:     // Skip `env` and any leading `VAR=value` assignments.
  247:     if words.peek() == Some(&"env") {
  248:         words.next();
  249:     }
  250:     while words
  251:         .peek()
  252:         .is_some_and(|word| word.split_once('=').is_some_and(|(key, _)| !key.is_empty()))
  253:     {
  254:         words.next();
  255:     }
  256:     let Some(program) = words.next().map(program_name) else {
  257:         return false;
  258:     };
  259:     let Some((_, subcommands)) = SHRINKABLE
  260:         .iter()
  261:         .find(|(candidate, _)| *candidate == program)
  262:     else {
  263:         return false;
  264:     };
  265:     if subcommands.is_empty() {
  266:         return true;
  267:     }
  268:     // The first argument that is not a flag is the subcommand.
  269:     words
  270:         .find(|word| !word.starts_with('-'))
  271:         .is_some_and(|subcommand| subcommands.contains(&subcommand))
  272: }
  273: 
  274: /// Reduces a path such as `/usr/bin/cargo` or `cargo.exe` to `cargo`.
  275: fn program_name(program: &str) -> &str {
  276:     let name = program
  277:         .rsplit_once(['/', '\\'])
  278:         .map_or(program, |(_, name)| name);
  279:     name.strip_suffix(".exe").unwrap_or(name)
  280: }
  281: 
  282: /// Keeps the head and tail of `text`, replacing the middle with an explicit marker.
  283: ///
  284: /// Returns the shrunk text and the number of lines it dropped, or `None` when the text is small
  285: /// enough that shrinking would not be worth the lost detail.
  286: fn shrink_text(text: &str) -> Option<(String, usize)> {
  287:     let lines: Vec<&str> = text.lines().collect();
  288:     if lines.len() < MIN_LINES_TO_SHRINK {
  289:         return None;
  290:     }
  291:     let removed = lines.len() - KEEP_HEAD_LINES - KEEP_TAIL_LINES;
  292:     let head = lines[..KEEP_HEAD_LINES].join("\n");
  293:     let tail = lines[lines.len() - KEEP_TAIL_LINES..].join("\n");
  294:     // The marker names the exit status and the actor. A model that cannot tell whether the
  295:     // command succeeded, or whether the command itself printed nothing, will run it again.
  296:     Some((
  297:         format!(
  298:             "{head}\n\n[system] exit 0 - the harness trimmed this output, the command did not. \
  299:              {removed} middle lines removed; re-running the command produces the same trimmed \
  300:              result.\n\n{tail}"
  301:         ),
  302:         removed,
  303:     ))
  304: }
