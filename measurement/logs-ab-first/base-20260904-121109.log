  13: CREATE TABLE IF NOT EXISTS "user" (
  14:     id INTEGER PRIMARY KEY AUTOINCREMENT,
  15:     email TEXT NOT NULL UNIQUE,
  16:     password_hash TEXT NOT NULL,
  17:     role TEXT NOT NULL CHECK (role IN ('customer', 'restaurant', 'courier')),
  18:     balance REAL NOT NULL DEFAULT 0
