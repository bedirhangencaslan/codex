 247: @router.get("/restaurant/earnings")
 248: def restaurant_earnings(user_restaurant=Depends(require_restaurant)) -> dict[str, Any]:
 249:     _, restaurant = user_restaurant
 250:     with get_db() as conn:
 251:         overall = conn.execute(
 252:             """SELECT COUNT(*) AS order_count,
 253:                       COALESCE(SUM(total), 0) AS revenue
 254:                FROM "order" WHERE restaurant_id = ?""",
 255:             (restaurant["id"],),
 256:         ).fetchone()
 257:         confirmed = conn.execute(
 258:             """SELECT COUNT(*) AS order_count,
 259:                       COALESCE(SUM(total), 0) AS revenue
 260:                FROM "order"
 261:                WHERE restaurant_id = ? AND status = 'onayland\u0131'""",
 262:             (restaurant["id"],),
 263:         ).fetchone()
 264:     average = round(overall["revenue"] / overall["order_count"], 2) if overall["order_count"] else 0
 265:     return {
 266:         "total_revenue": round(overall["revenue"], 2),
 267:         "confirmed_revenue": round(confirmed["revenue"], 2),
 268:         "pending_revenue": round(overall["revenue"] - confirmed["revenue"], 2),
 269:         "order_count": overall["order_count"],
 270:         "confirmed_order_count": confirmed["order_count"],
 271:         "average_order_value": average,
 272:     }
