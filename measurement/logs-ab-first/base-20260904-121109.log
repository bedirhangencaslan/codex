   2:     id INTEGER PRIMARY KEY AUTOINCREMENT,
   3:     name TEXT NOT NULL,
   4:     cuisine TEXT NOT NULL,
   5:     rating REAL NOT NULL,
   6:     delivery_fee REAL NOT NULL,
   7:     min_order REAL NOT NULL,
   8:     eta_minutes INTEGER NOT NULL,
   9:     image_emoji TEXT NOT NULL,
  10:     user_id INTEGER REFERENCES "user"(id)
  11: );
