  121: /// Replaces the middle of successful, noisy tool output with an explicit marker.
  122: ///
  123: /// `prefix_break` is the index the prompt cache is already invalidated from, or `None` when the
  124: /// prompt is byte-identical to the last one. Shrinking rewrites the output in place and so
  125: /// invalidates the cache from there to the end; doing it before the break would pay for a
  126: /// re-prefill in order to save tokens, which is the trade this harness exists to avoid.
  127: ///
  128: /// `is_completed` reports whether an item's turn has finished. Output from the running turn
  129: /// is left alone, because the model is still acting on it.
  130: pub(crate) fn shrink_completed_outputs(
  131:     items: &mut [ResponseItemEnvelope],
  132:     prefix_break: Option<usize>,
  133:     is_completed: impl Fn(&ResponseItemEnvelope) -> bool,
  134: ) -> ShrinkReport {
  135:     let mut report = ShrinkReport::default();
  136:     // The call ids are collected from the whole history: a call may sit in the untouched prefix
  137:     // while its output sits after the break.
  138:     let shrinkable = shrinkable_call_ids(items);
  139:     if shrinkable.is_empty() {
  140:         return report;
  141:     }
  142:     for (index, envelope) in items.iter_mut().enumerate() {
  143:         if !is_completed(envelope) {
  144:             continue;
  145:         }
  146:         let ResponseItem::FunctionCallOutput {
  147:             call_id, output, ..
  148:         } = &mut envelope.item
  149:         else {
  150:             continue;
  151:         };
  152:         // Only successful commands are shrunk. A failure's output is the most valuable thing
  153:         // in the context and is always kept whole.
  154:         if output.success != Some(true) {
  155:             continue;
  156:         }
  157:         let Some(call_id) = call_id.as_deref().filter(|id| shrinkable.contains(*id)) else {
  158:             continue;
  159:         };
  160:         let FunctionCallOutputBody::Text(text) = &mut output.body else {
  161:             continue;
  162:         };
  163:         let Some((shrunk, lines_removed)) = shrink_text(text) else {
  164:             continue;
  165:         };
  166:         if !prefix_break.is_some_and(|prefix_break| index >= prefix_break) {
  167:             report.shrinkable_before_break += 1;
  168:             continue;
  169:         }
  170:         report.outputs += 1;
  171:         report.lines_removed += lines_removed;
  172:         report.tokens_removed = report.tokens_removed.saturating_add(
  173:             i64::try_from(approx_token_count(text).saturating_sub(approx_token_count(&shrunk)))
  174:                 .unwrap_or(i64::MAX),
