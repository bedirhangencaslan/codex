            .record_retention_horizon(Some(crate::reasoning_retention::horizon(
                &crate::reasoning_retention::RetentionInputs {
                    budget_remaining,
                    requests_per_window: self.request_density.requests_per_window(),
                },
            )));
        let growth = {
