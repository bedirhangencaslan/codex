  282: /// Keeps the head and tail of `text`, replacing the middle with an explicit marker.
  283: ///
  284: /// Returns the shrunk text and the number of lines it dropped, or `None` when the text is small
  285: /// enough that shrinking would not be worth the lost detail.
  286: fn shrink_text(text: &str) -> Option<(String, usize)> {
  287:     let lines: Vec<&str> = text.lines().collect();
  288:     if lines.len() < MIN_LINES_TO_SHRINK {
  289:         return None;
  290:     }
  291:     let removed = lines.len() - KEEP_HEAD_LINES - KEEP_TAIL_LINES;
  292:     let head = lines[..KEEP_HEAD_LINES].join("\n");
  293:     let tail = lines[lines.len() - KEEP_TAIL_LINES..].join("\n");
  294:     // The marker names the exit status and the actor. A model that cannot tell whether the
  295:     // command succeeded, or whether the command itself printed nothing, will run it again.
  296:     Some((
  297:         format!(
  298:             "{head}\n\n[system] exit 0 - the harness trimmed this output, the command did not. \
  299:              {removed} middle lines removed; re-running the command produces the same trimmed \
  300:              result.\n\n{tail}"
  301:         ),
  302:         removed,
  303:     ))
  304: }
