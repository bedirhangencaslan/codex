            state.history.freeze_reasoning_retention(
                Some(step_context.turn.sub_id.as_str()),
                budget_remaining,
                status.active_context_tokens,
                self.request_density.requests_per_window(),
            )
        };
        self.request_density.observe(growth).await;
    }

