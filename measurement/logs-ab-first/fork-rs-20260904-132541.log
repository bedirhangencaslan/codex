  615:     /// This function enforces a couple of invariants on the in-memory history:
  616:     /// 1. every call (function/custom) has a corresponding output entry
  617:     /// 2. every output has a corresponding call entry or names an external tool event
  618:     /// 3. unsupported image and audio content is stripped from messages and tool outputs
  619:     fn normalize_history(&mut self, input_modalities: &[InputModality]) {
  620:         let items = Arc::make_mut(&mut self.items);
