  582:     /// Approximates the input the next request will actually carry.
  583:     ///
  584:     /// `last_token_usage.total_tokens` counts everything the last request billed, including the
  585:     /// reasoning it produced. Reasoning is turn-scoped, so once the turn that produced it has
  586:     /// ended it is no longer sent and must be discounted; `active_turn_id` identifies the turn the
  587:     /// caller is about to sample for, and reasoning still belonging to that turn is left in.
  588:     pub(crate) fn get_total_token_usage(&self, active_turn_id: Option<&str>) -> i64 {
  589:         let last_tokens = self
  590:             .token_info
  591:             .as_ref()
  592:             .map(|info| info.last_token_usage.total_tokens)
  593:             .unwrap_or(0);
  594:         let finished_turn_reasoning_tokens = self
  595:             .turn_reasoning_output_tokens
  596:             .as_ref()
  597:             .filter(|(turn_id, _)| Some(turn_id.as_str()) != active_turn_id)
  598:             .map_or(0, |(_, tokens)| *tokens);
  599:         let items_after_last_model_generated_tokens = self
  600:             .items_after_last_model_generated_item()
  601:             .map(estimate_item_token_count)
  602:             .fold(0i64, i64::saturating_add);
  603:         last_tokens
  604:             .saturating_sub(finished_turn_reasoning_tokens)
  605:             .max(0)
  606:             .saturating_add(items_after_last_model_generated_tokens)
  607:     }
