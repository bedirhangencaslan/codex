  302:     /// Returns normalized history envelopes for internal consumers that must retain metadata.
  303:     ///
  304:     /// Two kinds of item are scoped to the turn that produced them and are dropped once
  305:     /// that turn finishes: everything recorded by an invisible turn, and reasoning that was
  306:     /// priced as cheaper to drop than to keep. The still-running turn named by `active_turn_id`
  307:     /// keeps its own items, so the model can act on the request it is answering and follow its
  308:     /// own thinking across the tool-call loop. Passing `None` means no turn is running, which
  309:     /// drops all of them.
  310:     ///
  311:     /// Tool output from a finished turn survives, but noisy build and test output is shrunk to
  312:     /// its head and tail. Shrinking rewrites the output in place, so it is only free from the
  313:     /// first dropped item onwards, where the prompt cache is already invalidated. When nothing
  314:     /// was dropped, nothing is shrunk and the prefix stays byte-identical.
  315:     pub(crate) fn for_prompt_annotated(
  316:         mut self,
  317:         input_modalities: &[InputModality],
  318:         active_turn_id: Option<&str>,
  319:     ) -> (Vec<ResponseItemEnvelope>, ContextFilterReport) {
  320:         let mut report = ContextFilterReport::default();
  321:         self.drop_completed_turn_scoped_items(active_turn_id, &mut report);
  322:         self.normalize_history(input_modalities);
  323:         let mut items = Arc::unwrap_or_clone(self.items);
  324:         report.shrink = shrink_completed_outputs(&mut items, report.prefix_break, |envelope| {
  325:             let owner = envelope
  326:                 .metadata
  327:                 .as_ref()
  328:                 .and_then(|metadata| metadata.tool_output_turn.as_deref());
  329:             !belongs_to_active_turn(active_turn_id, owner)
  330:         });
  331:         // The re-prefill the break costs is the part of the prompt that follows it, measured on
  332:         // the prompt as finally sent rather than on the history it was built from.
  333:         if let Some(prefix_break) = report.prefix_break {
  334:             report.prefix_break_tokens = items
  335:                 .iter()
  336:                 .skip(prefix_break)
  337:                 .map(|envelope| measured_item_token_count(&envelope.item))
  338:                 .fold(0i64, i64::saturating_add);
  339:         }
  340:         (items, report)
  341:     }
