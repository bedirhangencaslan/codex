  182: /// Collects the call ids whose command is on the allowlist.
  183: fn shrinkable_call_ids(items: &[ResponseItemEnvelope]) -> HashSet<String> {
  184:     let mut by_call_id: HashMap<&str, &str> = HashMap::new();
  185:     for envelope in items {
