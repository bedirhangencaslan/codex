  155: pub(crate) fn remove_orphan_outputs(items: &mut Vec<ResponseItemEnvelope>) {
  156:     let mut function_call_ids = HashSet::new();
  157:     let mut tool_search_call_ids = HashSet::new();
  158:     let mut custom_tool_call_ids = HashSet::new();
  159:     for envelope in items.iter() {
  160:         match &envelope.item {
  161:             ResponseItem::FunctionCall { call_id, .. }
  162:             | ResponseItem::LocalShellCall {
  163:                 call_id: Some(call_id),
  164:                 ..
  165:             } => {
  166:                 function_call_ids.insert(call_id.as_str());
  167:             }
  168:             ResponseItem::ToolSearchCall {
  169:                 call_id: Some(call_id),
  170:                 ..
  171:             } => {
  172:                 tool_search_call_ids.insert(call_id.as_str());
  173:             }
  174:             ResponseItem::CustomToolCall { call_id, .. } => {
  175:                 custom_tool_call_ids.insert(call_id.as_str());
  176:             }
  177:             _ => {}
  178:         }
  179:     }
  180: 
  181:     let mut orphan_positions = Vec::new();
  182:     for (position, envelope) in items.iter().enumerate() {
  183:         match &envelope.item {
  184:             ResponseItem::FunctionCallOutput {
  185:                 call_id: Some(call_id),
  186:                 ..
  187:             } if !function_call_ids.contains(call_id.as_str()) => {
  188:                 error_or_panic(format!(
  189:                     "Orphan function call output for call id: {call_id}"
  190:                 ));
  191:                 orphan_positions.push(position);
  192:             }
  193:             ResponseItem::CustomToolCallOutput { call_id, .. }
  194:                 if !custom_tool_call_ids.contains(call_id.as_str()) =>
  195:             {
  196:                 error_or_panic(format!(
  197:                     "Orphan custom tool call output for call id: {call_id}"
  198:                 ));
  199:                 orphan_positions.push(position);
  200:             }
  201:             ResponseItem::ToolSearchOutput {
  202:                 call_id: Some(call_id),
  203:                 execution,
  204:                 ..
  205:             } if execution != "server" && !tool_search_call_ids.contains(call_id.as_str()) => {
  206:                 error_or_panic(format!("Orphan tool search output for call id: {call_id}"));
  207:                 orphan_positions.push(position);
  208:             }
  209:             _ => {}
  210:         }
  211:     }
  212: 
  213:     if !orphan_positions.is_empty() {
  214:         let mut orphan_positions = orphan_positions.into_iter().peekable();
  215:         let mut position = 0;
  216:         items.retain(|_| {
  217:             let retain = orphan_positions.peek() != Some(&position);
  218:             if !retain {
  219:                 orphan_positions.next();
  220:             }
  221:             position += 1;
  222:             retain
