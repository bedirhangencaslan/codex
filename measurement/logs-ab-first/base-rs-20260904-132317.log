  615:     /// This function enforces a couple of invariants on the in-memory history:
  616:     /// 1. every call (function/custom) has a corresponding output entry
  617:     /// 2. every output has a corresponding call entry or names an external tool event
  618:     /// 3. unsupported image and audio content is stripped from messages and tool outputs
  619:     fn normalize_history(&mut self, input_modalities: &[InputModality]) {
  620:         let items = Arc::make_mut(&mut self.items);
  621: 
  622:         // all function/tool calls must have a corresponding output
  623:         normalize::ensure_call_outputs_present(items);
  624: 
  625:         // Paired outputs must have a corresponding call; named external outputs stand alone.
  626:         normalize::remove_orphan_outputs(items);
  627: 
  628:         // strip images when model does not support them
  629:         normalize::strip_images_when_unsupported(input_modalities, items);
  630: 
  631:         // strip audio when model does not support it
  632:         normalize::strip_audio_when_unsupported(input_modalities, items);
  633:     }
