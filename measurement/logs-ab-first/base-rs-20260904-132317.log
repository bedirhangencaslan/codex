  548:     pub(crate) fn update_token_info(
  549:         &mut self,
  550:         usage: &TokenUsage,
  551:         model_context_window: Option<i64>,
  552:         turn_id: &str,
  553:     ) {
  554:         self.token_info = TokenUsageInfo::new_or_append(
  555:             &self.token_info,
  556:             &Some(usage.clone()),
  557:             model_context_window,
  558:         );
  559:         // A turn can span several requests; every one of them charges reasoning that is only
  560:         // resent for the remainder of that same turn, so accumulate across the whole turn.
  561:         match &mut self.turn_reasoning_output_tokens {
  562:             Some((id, tokens)) if id == turn_id => {
  563:                 *tokens = tokens.saturating_add(usage.reasoning_output_tokens);
  564:             }
  565:             slot => *slot = Some((turn_id.to_string(), usage.reasoning_output_tokens)),
  566:         }
  567:     }
