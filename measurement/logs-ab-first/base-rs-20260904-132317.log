  319: fn remove_first_matching<F>(items: &mut Vec<ResponseItemEnvelope>, predicate: F)
  320: where
  321:     F: Fn(&ResponseItem) -> bool,
  322: {
  323:     if let Some(pos) = items.iter().position(|envelope| predicate(&envelope.item)) {
  324:         items.remove(pos);
  325:     }
  326: }
