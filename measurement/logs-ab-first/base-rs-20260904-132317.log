  209:         serde_json::Value::String(line) => shell_words(line),
  210:         serde_json::Value::Array(argv) => {
  211:             let argv: Vec<&str> = argv.iter().filter_map(serde_json::Value::as_str).collect();
  212:             // `bash -lc "<script>"` hides the real command in the trailing argument.
