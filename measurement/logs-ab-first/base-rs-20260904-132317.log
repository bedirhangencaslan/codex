   64: /// one. `retained_reasoning_tokens` instead rides along in the cached prefix for the whole
   65: /// horizon. The break that minimizes this sum is the one to take.
   66: fn break_cost(suffix_tokens: i64, retained_reasoning_tokens: i64, horizon: i64) -> f64 {
   67:     let cached_ratio = CACHED_INPUT_PRICE_RATIO;
