  569:     // These are local items added after the most recent model-emitted item.
  570:     // They are not reflected in `last_token_usage.total_tokens`.
  571:     fn items_after_last_model_generated_item(
  572:         &self,
  573:     ) -> impl Clone + ExactSizeIterator<Item = &ResponseItem> + DoubleEndedIterator {
  574:         let start = self
  575:             .items
  576:             .iter()
  577:             .rposition(|envelope| is_model_generated_item(&envelope.item))
  578:             .map_or(self.items.len(), |index| index.saturating_add(1));
  579:         self.items[start..].iter().map(|envelope| &envelope.item)
  580:     }
