  328: /// Strip image content from messages and tool outputs when the model does not support images.
  329: /// When `input_modalities` contains `InputModality::Image`, no stripping is performed.
  330: pub(crate) fn strip_images_when_unsupported(
  331:     input_modalities: &[InputModality],
  332:     items: &mut [ResponseItemEnvelope],
  333: ) {
  334:     let supports_images = input_modalities.contains(&InputModality::Image);
  335:     if supports_images {
  336:         return;
  337:     }
  338: 
  339:     for envelope in items.iter_mut() {
  340:         match &mut envelope.item {
  341:             ResponseItem::Message { .. } => {
  342:                 let Some(mut content) = to_annotated_content(&mut envelope.item) else {
  343:                     continue;
  344:                 };
  345:                 for content_item in &mut content {
  346:                     if matches!(content_item.content(), ContentItem::InputImage { .. }) {
  347:                         *content_item = UnsupportedMedia::IMAGE.render_fragment().into_parts().1;
  348:                     }
  349:                 }
  350:                 let _ = set_annotated_content(&mut envelope.item, content);
  351:             }
  352:             ResponseItem::FunctionCallOutput { output, .. }
  353:             | ResponseItem::CustomToolCallOutput { output, .. } => {
  354:                 if let Some(content_items) = output.content_items_mut() {
  355:                     let mut normalized_content_items = Vec::with_capacity(content_items.len());
  356:                     for content_item in content_items.iter() {
  357:                         match content_item {
  358:                             FunctionCallOutputContentItem::InputImage { .. } => {
  359:                                 normalized_content_items.push(
  360:                                     FunctionCallOutputContentItem::InputText {
  361:                                         text: UnsupportedMedia::IMAGE.render(),
  362:                                     },
  363:                                 );
  364:                             }
  365:                             _ => normalized_content_items.push(content_item.clone()),
  366:                         }
  367:                     }
  368:                     *content_items = normalized_content_items;
  369:                 }
  370:             }
  371:             ResponseItem::ImageGenerationCall { result, .. } => {
  372:                 result.clear();
  373:             }
  374:             _ => {}
  375:         }
  376:     }
  377: }
