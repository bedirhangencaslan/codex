  343:     /// Drops turn-scoped items and records what that removed, including the index the prompt
  344:     /// cache is invalidated from.
  345:     ///
  346:     /// Removing an item rewrites the prompt from its position to the end, so the index of the
  347:     /// first removal is exactly where the surviving prefix stops being byte-identical.
  348:     fn drop_completed_turn_scoped_items(
  349:         &mut self,
  350:         active_turn_id: Option<&str>,
  351:         report: &mut ContextFilterReport,
  352:     ) {
  353:         let mut position = 0;
  354:         Arc::make_mut(&mut self.items).retain(|envelope| {
  355:             let index = position;
  356:             position += 1;
  357:             let tokens = measured_item_token_count(&envelope.item);
  358:             match dropped_reason(envelope, active_turn_id) {
  359:                 Some(reason) => {
  360:                     report.prefix_break.get_or_insert(index);
  361:                     match reason {
  362:                         DropReason::Invisible => {
  363:                             report.dropped_invisible_items += 1;
  364:                             report.dropped_invisible_tokens =
  365:                                 report.dropped_invisible_tokens.saturating_add(tokens);
  366:                             if let Some(call_id) = call_id_of(&envelope.item) {
  367:                                 report.dropped_call_ids.push(call_id.to_string());
  368:                             }
  369:                         }
  370:                         DropReason::Reasoning => {
  371:                             report.dropped_reasoning_items += 1;
  372:                             report.dropped_reasoning_tokens =
  373:                                 report.dropped_reasoning_tokens.saturating_add(tokens);
  374:                         }
  375:                     }
  376:                     false
  377:                 }
  378:                 None => {
  379:                     if matches!(envelope.item, ResponseItem::Reasoning { .. }) {
  380:                         report.retained_reasoning_items += 1;
  381:                         report.retained_reasoning_tokens =
  382:                             report.retained_reasoning_tokens.saturating_add(tokens);
  383:                     }
  384:                     true
  385:                 }
  386:             }
  387:         });
  388:     }
