  293:     /// Context added since the previous pricing point. Compaction and rollback shrink the
  294:     /// context; only forward growth says anything about what the next request will add.
  295:     fn observe_context_growth(&mut self, context_tokens: i64) -> i64 {
  296:         match self.last_decision_context_tokens.replace(context_tokens) {
  297:             Some(previous) => context_tokens.saturating_sub(previous).max(0),
  298:             None => 0,
  299:         }
  300:     }
