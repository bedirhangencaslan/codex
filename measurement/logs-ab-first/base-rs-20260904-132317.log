  200: /// Reads the command out of a tool call's JSON arguments and matches it against the allowlist.
  201: fn command_is_shrinkable(arguments: &str) -> bool {
  202:     let Ok(parsed) = serde_json::from_str::<serde_json::Value>(arguments) else {
  203:         return false;
  204:     };
  205:     let Some(command) = parsed.get("command") else {
