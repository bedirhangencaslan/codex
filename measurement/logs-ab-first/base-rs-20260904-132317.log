  683: /// What building one request's prompt removed from history, and what that cost.
  684: ///
  685: /// Adding the dropped and shrunk sizes back onto the prompt that was sent reconstructs the
  686: /// prompt an unfiltered harness would have sent, which is what makes the turn-scoped filters
  687: /// priceable without issuing a second request. Producing this changes nothing about the prompt.
  688: #[derive(Debug, Default, PartialEq, Eq)]
  689: pub(crate) struct ContextFilterReport {
  690:     /// Index the surviving prefix stops being byte-identical from, or `None` when nothing was
  691:     /// removed and the prompt cache keeps the whole prefix.
  692:     pub(crate) prefix_break: Option<usize>,
  693:     /// Prompt tokens after the break, which this request re-prefills at the uncached rate.
  694:     pub(crate) prefix_break_tokens: i64,
  695:     pub(crate) dropped_invisible_items: usize,
  696:     pub(crate) dropped_invisible_tokens: i64,
  697:     pub(crate) dropped_reasoning_items: usize,
  698:     pub(crate) dropped_reasoning_tokens: i64,
  699:     pub(crate) retained_reasoning_items: usize,
  700:     pub(crate) retained_reasoning_tokens: i64,
  701:     pub(crate) dropped_call_ids: Vec<String>,
  702:     pub(crate) shrink: ShrinkReport,
  703: }
  704: 
  705: /// Why an item recorded in history does not reach the model.
  706: enum DropReason {
  707:     /// Recorded by an invisible turn that has since finished.
  708:     Invisible,
  709:     /// Reasoning from a finished turn that was priced as cheaper to drop than to carry.
  710:     Reasoning,
  711: }
  712: 
  713: /// Whether a turn-scoped item is dropped from this request, and on which of the two grounds.
  714: fn dropped_reason(
  715:     envelope: &ResponseItemEnvelope,
  716:     active_turn_id: Option<&str>,
  717: ) -> Option<DropReason> {
  718:     let metadata = envelope.metadata.as_ref();
  719:     let invisible_owner = metadata.and_then(|metadata| metadata.invisible_turn.as_deref());
  720:     if invisible_owner.is_some() && !belongs_to_active_turn(active_turn_id, invisible_owner) {
  721:         return Some(DropReason::Invisible);
  722:     }
  723:     if !matches!(envelope.item, ResponseItem::Reasoning { .. }) {
  724:         return None;
  725:     }
  726:     if belongs_to_active_turn(
  727:         active_turn_id,
  728:         metadata.and_then(|metadata| metadata.reasoning_turn.as_deref()),
  729:     ) {
  730:         return None;
  731:     }
  732:     // `Some(true)` is the frozen verdict that this reasoning is cheaper to carry in the cached
  733:     // prefix than the re-prefill dropping it would cost. The verdict is a property of the
  734:     // reasoning, not of the caller, so a prompt that names no active turn honours it too: naming
  735:     // no turn means "nothing here is still being written", not "drop what was kept".
  736:     // Reasoning that predates that verdict, or that was never stamped, is dropped as it always was.
  737:     (metadata.and_then(|metadata| metadata.reasoning_retained) != Some(true))
  738:         .then_some(DropReason::Reasoning)
  739: }
  740: 
  741: /// Size of one item as the prompt carries it.
  742: ///
  743: /// [`estimate_item_token_count`] reports reasoning as zero, because everywhere else in this
  744: /// codebase reasoning is something the server bills rather than something the prompt carries.
  745: /// Here the prompt is exactly what is being measured, so reasoning is measured directly.
  746: pub(crate) fn measured_item_token_count(item: &ResponseItem) -> i64 {
  747:     match item {
  748:         ResponseItem::Reasoning { .. } => crate::reasoning_retention::reasoning_tokens(item),
  749:         item => estimate_item_token_count(item),
  750:     }
  751: }
  752: 
  753: /// The tool call an item belongs to, so a dropped item can be paired with its output.
  754: fn call_id_of(item: &ResponseItem) -> Option<&str> {
  755:     match item {
  756:         ResponseItem::FunctionCall { call_id, .. } => Some(call_id.as_str()),
  757:         ResponseItem::FunctionCallOutput { call_id, .. } => call_id.as_deref(),
  758:         _ => None,
  759:     }
  760: }

