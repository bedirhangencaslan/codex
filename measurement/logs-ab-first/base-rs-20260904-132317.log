  480:     /// Drop the last `num_turns` instruction turns from this history.
  481:     ///
  482:     /// Instruction turns are history messages that should behave like a new prompt boundary:
  483:     /// ordinary user messages and structured assistant inter-agent instructions.
  484:     ///
  485:     /// This mirrors thread-rollback semantics:
  486:     /// - `num_turns == 0` is a no-op
  487:     /// - if there are no user turns, this is a no-op
  488:     /// - if `num_turns` exceeds the number of user turns, all user turns are dropped while
  489:     ///   preserving any items that occurred before the first user message.
  490:     ///
  491:     /// If rollback trims a pre-turn developer message that mixes contextual fragments with
  492:     /// persistent developer text from `build_initial_context`, this also clears
  493:     /// `reference_context_item`. The surviving history no longer contains the full bundle that
  494:     /// established the prior baseline, so future turns must fall back to full reinjection instead
  495:     /// of diffing against stale state.
  496:     pub(crate) fn drop_last_n_user_turns(&mut self, num_turns: u32) {
  497:         if num_turns == 0 {
  498:             return;
  499:         }
  500: 
  501:         let snapshot = self.items.clone();
  502:         let user_positions = user_message_positions(&snapshot);
  503:         let Some(&first_instruction_turn_idx) = user_positions.first() else {
  504:             self.replace_annotated(Arc::unwrap_or_clone(snapshot));
  505:             return;
  506:         };
  507: 
  508:         let n_from_end = usize::try_from(num_turns).unwrap_or(usize::MAX);
  509:         let mut cut_idx = if n_from_end >= user_positions.len() {
  510:             first_instruction_turn_idx
  511:         } else {
  512:             user_positions[user_positions.len() - n_from_end]
  513:         };
  514: 
  515:         cut_idx =
  516:             self.trim_pre_turn_context_updates(&snapshot, first_instruction_turn_idx, cut_idx);
  517: 
  518:         let mut retained_items = snapshot[..cut_idx].to_vec();
  519:         if cut_idx == first_instruction_turn_idx
  520:             && let Some(first_turn_id) = snapshot[first_instruction_turn_idx].turn_id()
  521:         {
  522:             retained_items.retain_mut(|item| {
  523:                 if item.turn_id() == Some(first_turn_id)
  524:                     && matches!(&item.item, ResponseItem::Message { role, .. } if role == "developer")
  525:                 {
  526:                     let Some(mut content) = to_annotated_content(&mut item.item) else {
  527:                         return false;
  528:                     };
  529:                     content.retain(|content| {
  530:                         // Rebuild these from the next step's model and effort after rollback.
  531:                         !matches!(
  532:                             content.content(),
  533:                             ContentItem::InputText { text }
  534:                                 if ModelSwitchInstructions::matches_text(text)
  535:                                     || PersistentModeState::matches_text(text)
  536:                         )
  537:                     });
  538:                     !content.is_empty() && set_annotated_content(&mut item.item, content).is_some()
  539:                 } else {
  540:                     true
  541:                 }
  542:             });
  543:         }
  544: 
  545:         self.replace_annotated(retained_items);
  546:     }
