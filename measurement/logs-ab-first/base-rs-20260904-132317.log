  419:     // Estimate token usage using byte-based heuristics from the truncation helpers.
  420:     // This is a coarse lower bound, not a tokenizer-accurate count.
  421:     pub(crate) fn estimate_token_count(&self, turn_context: &TurnContext) -> Option<i64> {
  422:         let model_info = &turn_context.model_info();
  423:         let personality = turn_context
  424:             .personality()
  425:             .or(turn_context.config.personality);
  426:         let base_instructions = BaseInstructions {
  427:             text: model_info.get_model_instructions(personality),
  428:             provenance: None,
  429:         };
  430:         self.estimate_token_count_with_base_instructions(&base_instructions)
  431:     }
  432: 
  433:     pub(crate) fn estimate_token_count_with_base_instructions(
  434:         &self,
  435:         base_instructions: &BaseInstructions,
  436:     ) -> Option<i64> {
  437:         let base_tokens =
  438:             i64::try_from(approx_token_count(&base_instructions.text)).unwrap_or(i64::MAX);
  439: 
  440:         let items_tokens = self
  441:             .items
  442:             .iter()
  443:             .map(|envelope| estimate_item_token_count(&envelope.item))
  444:             .fold(0i64, i64::saturating_add);
  445: 
  446:         Some(base_tokens.saturating_add(items_tokens))
  447:     }
