  635:     /// Walk backward from a rollback cut and trim contiguous pre-turn context-update items.
  636:     ///
  637:     /// Returns the adjusted cut index after removing contextual developer/user items immediately
  638:     /// above the rolled-back turn boundary.
  639:     ///
  640:     /// `first_instruction_turn_idx` is the earliest rollback-eligible instruction-turn boundary
  641:     /// in `snapshot`; the trim walk never crosses it so any session-prefix items that predate the
  642:     /// first real turn survive rollback.
  643:     ///
  644:     /// `cut_idx` is the tentative slice boundary after dropping the requested number of
  645:     /// instruction turns, before stripping contextual pre-turn items that sit immediately above
  646:     /// that boundary.
  647:     ///
  648:     /// If any trimmed developer message was a mixed `build_initial_context` bundle containing both
  649:     /// rollback-trimmable contextual fragments and persistent developer text, this also clears the
  650:     /// stored `reference_context_item` baseline so the next real turn falls back to full
  651:     /// reinjection.
  652:     fn trim_pre_turn_context_updates(
  653:         &mut self,
  654:         snapshot: &[ResponseItemEnvelope],
  655:         first_instruction_turn_idx: usize,
  656:         mut cut_idx: usize,
  657:     ) -> usize {
  658:         while cut_idx > first_instruction_turn_idx {
  659:             match &snapshot[cut_idx - 1].item {
  660:                 ResponseItem::Message { role, content, .. }
  661:                     if role == "developer" && is_contextual_dev_message_content(content) =>
  662:                 {
  663:                     if has_non_contextual_dev_message_content(content) {
  664:                         // Mixed `build_initial_context` bundles are not reconstructible from
  665:                         // steady-state diffs once trimmed, so the next real turn must fully
  666:                         // reinject context instead of diffing against a stale baseline.
  667:                         self.reference_context_item = None;
  668:                     }
  669:                     cut_idx -= 1;
  670:                 }
  671:                 ResponseItem::Message { role, content, .. }
  672:                     if role == "user" && is_contextual_user_message_content(content) =>
  673:                 {
  674:                     cut_idx -= 1;
  675:                 }
  676:                 _ => break,
  677:             }
  678:         }
  679:         cut_idx
  680:     }
  681: }
