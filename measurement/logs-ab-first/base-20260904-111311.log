  95:                LEFT JOIN courier c ON c.id = o.courier_id
  96:                WHERE o.restaurant_id = ?"""
  97:     params: list[Any] = [restaurant["id"]]
  98:     if status:
  99:         query += " AND o.status = ?"
 100:         params.append(status)
 101:     with get_db() as conn:
 102:         rows = conn.execute(query + " ORDER BY o.created_at DESC", params).fetchall()
 103:     return serialize_orders(conn, rows)
