                continue
            restaurant_id = row["id"]
            owner_cursor = conn.execute(
                'INSERT INTO "user" (email, password_hash, role, balance) VALUES (?, ?, ?, ?)',
                (f"sahip.{slug}@sepet.test", password_hash, "restaurant", 0.0),
