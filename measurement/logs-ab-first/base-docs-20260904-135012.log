                        restaurant_id,
                        f"{restaurant['name']} Kurye {number}",
                    ),
                )

        print("Demo musteri: musteri@sepet.test / sepet123")
        print(f"{len(RESTAURANTS)} restoran ve veritabani olusturuldu: {DB_PATH}")


