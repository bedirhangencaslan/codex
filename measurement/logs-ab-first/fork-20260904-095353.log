   4: 
   5: export default function CourierPanel() {
   6:   const [orders, setOrders] = useState<Order[]>([]);
   7:   const [loading, setLoading] = useState(true);
   8:   const [error, setError] = useState("");
   9: 
  10:   const load = () => {
  11:     setLoading(true);
  12:     fetchCourierOrders()
  13:       .then(setOrders)
  14:       .catch(() => setError("Kurye sipariÅŸleri yÃ¼klenemedi"))
  15:       .finally(() => setLoading(false));
  16:   };
  17: 
  18:   useEffect(load, []);
  19: 
  20:   async function deliver(id: number) {
  21:     await deliverOrder(id);
  22:     load();
  23:   }
  24: 
  25:   if (loading) return <div className="status">SipariÅŸler yÃ¼kleniyor...</div>;
  26:   if (error) return <div className="status error">{error}</div>;
  27:   if (!orders.length) return <div className="empty-state"><strong>Size atanmÄ±ÅŸ sipariÅŸ yok</strong><p>Yeni atamalar burada listelenir.</p></div>;
  28: 
  29:   return (
  30:     <div className="panel-list">
  31:       {orders.map((order) => (
  32:         <article key={order.id} className="panel-card">
  33:           <div className="order-head">
  34:             <strong>#{order.id} {order.restaurant_name}</strong>
  35:             <span className="status-pill">{order.status}</span>
  36:           </div>
  37:           <p className="muted">{order.address}</p>
  38:           <p className="muted">{order.phone} Â· {order.total.toFixed(2)} TL</p>
  39:           <div className="order-actions">
  40:             {order.status === "kuryede" && <button className="primary-button" onClick={() => deliver(order.id)}>Teslim ettim</button>}
  41:           </div>
  42:         </article>
  43:       ))}
  44:     </div>
  45:   );
  46: }
