 249:     _, restaurant = user_restaurant
 250:     with get_db() as conn:
 251:         overall = conn.execute(
 252:             """SELECT COUNT(*) AS order_count,
 253:                       COALESCE(SUM(total), 0) AS revenue
 254:                FROM "order" WHERE restaurant_id = ?""",
 255:             (restaurant["id"],),
