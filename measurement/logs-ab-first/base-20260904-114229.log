  46:                (restaurant_id, user_id, rating, comment, created_at)
  47:                VALUES (?, ?, ?, ?, ?)""",
  48:             (restaurant_id, user["id"], payload.rating, payload.comment.strip(), utc_now()),
  49:         )
  50:     return {"id": cursor.lastrowid, "rating": payload.rating, "comment": payload.comment.strip(), "user_email": user["email"]}
