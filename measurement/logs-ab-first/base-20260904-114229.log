  54:         """SELECT o.*, r.name AS restaurant_name,
  55:                   u.email AS customer_email, c.name AS courier_name
  56:            FROM "order" o
  57:            JOIN restaurant r ON r.id = o.restaurant_id
  58:            LEFT JOIN "user" u ON u.id = o.customer_id
  59:            LEFT JOIN courier c ON c.id = o.courier_id
  60:            WHERE o.id = ?""",
  61:         (order_id,),
  62:     ).fetchone()
  63:     if not order:
  64:         return None
  65:     return serialize_orders(conn, [order])[0]
