  20:     restaurant_id: int,
  21:     payload: ReviewInput,
  22:     user=Depends(require_customer),
  23: ) -> dict[str, Any]:
  24:     if not payload.comment.strip():
  25:         raise HTTPException(status_code=400, detail="Yorum metni zorunludur")
  26:     with get_db() as conn:
  27:         restaurant = conn.execute(
  28:             "SELECT id FROM restaurant WHERE id = ?", (restaurant_id,)
  29:         ).fetchone()
  30:         if not restaurant:
  31:             raise HTTPException(status_code=404, detail="Restoran bulunamadi")
  32:         approved = conn.execute(
  33:             """SELECT 1 FROM "order"
  34:                WHERE customer_id = ? AND restaurant_id = ? AND status = 'onaylandı'""",
  35:             (user["id"], restaurant_id),
  36:         ).fetchone()
  37:         if not approved:
  38:             raise HTTPException(status_code=403, detail="Yorum icin onayli siparis gerekli")
  39:         if conn.execute(
  40:             "SELECT 1 FROM restaurant_review WHERE restaurant_id = ? AND user_id = ?",
  41:             (restaurant_id, user["id"]),
  42:         ).fetchone():
  43:             raise HTTPException(status_code=409, detail="Bu restorana yorum yaptiniz")
  44:         cursor = conn.execute(
