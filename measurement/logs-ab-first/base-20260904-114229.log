### sepet/api/schema.sql
   1: CREATE TABLE IF NOT EXISTS restaurant (
   2:     id INTEGER PRIMARY KEY AUTOINCREMENT,
   3:     name TEXT NOT NULL,
   4:     cuisine TEXT NOT NULL,
   5:     rating REAL NOT NULL,
   6:     delivery_fee REAL NOT NULL,
   7:     min_order REAL NOT NULL,
   8:     eta_minutes INTEGER NOT NULL,
   9:     image_emoji TEXT NOT NULL,
  10:     user_id INTEGER REFERENCES "user"(id)
  11: );
  12: 
  13: CREATE TABLE IF NOT EXISTS "user" (
  14:     id INTEGER PRIMARY KEY AUTOINCREMENT,
  15:     email TEXT NOT NULL UNIQUE,
  16:     password_hash TEXT NOT NULL,
  17:     role TEXT NOT NULL CHECK (role IN ('customer', 'restaurant', 'courier')),
  18:     balance REAL NOT NULL DEFAULT 0
  19: );
  20: 
  21: CREATE TABLE IF NOT EXISTS auth_token (
  22:     token TEXT PRIMARY KEY,
  23:     user_id INTEGER NOT NULL REFERENCES "user"(id),
  24:     created_at TEXT NOT NULL
  25: );
  26: 
  27: CREATE TABLE IF NOT EXISTS courier (
  28:     id INTEGER PRIMARY KEY AUTOINCREMENT,
  29:     user_id INTEGER NOT NULL UNIQUE REFERENCES "user"(id),
  30:     restaurant_id INTEGER NOT NULL REFERENCES restaurant(id),
  31:     name TEXT NOT NULL
  32: );
  33: 
  34: CREATE TABLE IF NOT EXISTS restaurant_review (
  35:     id INTEGER PRIMARY KEY AUTOINCREMENT,
  36:     restaurant_id INTEGER NOT NULL REFERENCES restaurant(id),
  37:     user_id INTEGER NOT NULL REFERENCES "user"(id),
  38:     rating INTEGER NOT NULL CHECK (rating BETWEEN 1 AND 5),
  39:     comment TEXT NOT NULL,
  40:     created_at TEXT NOT NULL,
  41:     UNIQUE (restaurant_id, user_id)
  42: );
  43: 
  44: CREATE TABLE IF NOT EXISTS menu_item (
  45:     id INTEGER PRIMARY KEY AUTOINCREMENT,
  46:     restaurant_id INTEGER NOT NULL REFERENCES restaurant(id),
  47:     name TEXT NOT NULL,
  48:     description TEXT NOT NULL,
  49:     price REAL NOT NULL,
  50:     category TEXT NOT NULL
  51: );
  52: 
  53: CREATE TABLE IF NOT EXISTS "order" (
  54:     id INTEGER PRIMARY KEY AUTOINCREMENT,
  55:     restaurant_id INTEGER NOT NULL REFERENCES restaurant(id),
  56:     address TEXT NOT NULL,
  57:     phone TEXT NOT NULL,
  58:     note TEXT NOT NULL DEFAULT '',
  59:     total REAL NOT NULL,
  60:     status TEXT NOT NULL DEFAULT 'hazÃ„Â±rlanÃ„Â±yor',
  61:     created_at TEXT NOT NULL,
  62:     customer_id INTEGER REFERENCES "user"(id),
  63:     courier_id INTEGER REFERENCES courier(id),
  64:     courier_assigned_at TEXT,
  65:     delivered_at TEXT,
  66:     confirmed_at TEXT
  67: );
  68: 
  69: CREATE TABLE IF NOT EXISTS order_item (
  70:     id INTEGER PRIMARY KEY AUTOINCREMENT,
  71:     order_id INTEGER NOT NULL REFERENCES "order"(id),
  72:     menu_item_id INTEGER NOT NULL REFERENCES menu_item(id),
  73:     name TEXT NOT NULL,
  74:     unit_price REAL NOT NULL,
  75:     quantity INTEGER NOT NULL
  76: );
