===== web\src\AuthContext.tsx =====
   1: import { createContext, useCallback, useContext, useEffect, useMemo, useState, type ReactNode } from "react";
   2: import { fetchMe, login as loginRequest, registerAccount } from "./api";
   3: import type { User } from "./types";
   4: 
   5: type AuthState = {
   6:   user: User | null;
   7:   ready: boolean;
   8:   login: (email: string, password: string) => Promise<void>;
   9:   register: (payload: Record<string, unknown>) => Promise<void>;
  10:   logout: () => void;
  11:   refreshUser: () => Promise<void>;
  12: };
  13: 
  14: const AuthContext = createContext<AuthState | null>(null);
  15: const STORAGE_KEY = "sepet-auth";
  16: 
  17: function readStored(): { token?: string; user?: User } {
  18:   try {
  19:     return JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "{}");
  20:   } catch {
  21:     return {};
  22:   }
  23: }
  24: 
  25: export function AuthProvider({ children }: { children: ReactNode }) {
  26:   const [user, setUser] = useState<User | null>(() => readStored().user ?? null);
  27:   const [ready, setReady] = useState(false);
  28: 
  29:   useEffect(() => {
  30:     const stored = readStored();
  31:     if (!stored.token) {
  32:       setReady(true);
  33:       return;
  34:     }
  35:     fetchMe()
  36:       .then(setUser)
  37:       .catch(() => setUser(null))
  38:       .finally(() => setReady(true));
  39:   }, []);
  40: 
  41:   const persist = (token: string, nextUser: User) => {
  42:     localStorage.setItem(STORAGE_KEY, JSON.stringify({ token, user: nextUser }));
  43:     setUser(nextUser);
  44:   };
  45: 
  46:   const login = useCallback(async (email: string, password: string) => {
  47:     const result = await loginRequest(email, password);
  48:     persist(result.token, result.user);
  49:   }, []);
  50: 
  51:   const register = useCallback(async (payload: Record<string, unknown>) => {
  52:     const result = await registerAccount(payload);
  53:     persist(result.token, result.user);
  54:   }, []);
  55: 
  56:   const logout = useCallback(() => {
  57:     localStorage.removeItem(STORAGE_KEY);
  58:     setUser(null);
  59:   }, []);
  60: 
  61:   const refreshUser = useCallback(async () => {
  62:     const nextUser = await fetchMe();
  63:     const stored = readStored();
  64:     localStorage.setItem(STORAGE_KEY, JSON.stringify({ ...stored, user: nextUser }));
  65:     setUser(nextUser);
  66:   }, []);
  67: 
  68:   const value = useMemo(
  69:     () => ({ user, ready, login, register, logout, refreshUser }),
  70:     [login, logout, ready, refreshUser, register, user],
  71:   );
  72:   return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
  73: }
  74: 
  75: export function useAuth() {
  76:   const context = useContext(AuthContext);
  77:   if (!context) throw new Error("useAuth AuthProvider icinde kullanilmali");
  78:   return context;
  79: }

===== web\src\CartContext.tsx =====
   1: import { createContext, useCallback, useContext, useEffect, useMemo, useState, type ReactNode } from "react";
   2: import type { CartLine, MenuItem } from "./types";
   3: 
   4: type CartState = {
   5:   lines: CartLine[];
   6:   restaurantId: number | null;
   7:   subtotal: number;
   8:   add: (item: MenuItem, deliveryFee: number) => void;
   9:   change: (itemId: number, delta: number) => void;
  10:   clear: () => void;
  11: };
  12: 
  13: const CartContext = createContext<CartState | null>(null);
  14: const STORAGE_KEY = "sepet-cart-v1";
  15: 
  16: type StoredCart = {
  17:   restaurantId: number | null;
  18:   lines: CartLine[];
  19: };
  20: 
  21: export function CartProvider({ children }: { children: ReactNode }) {
  22:   const [cart, setCart] = useState<StoredCart>(() => {
  23:     try {
  24:       const stored = localStorage.getItem(STORAGE_KEY);
  25:       return stored ? JSON.parse(stored) as StoredCart : { restaurantId: null, lines: [] };
  26:     } catch {
  27:       return { restaurantId: null, lines: [] };
  28:     }
  29:   });
  30: 
  31:   useEffect(() => {
  32:     localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
  33:   }, [cart]);
  34: 
  35:   const add = useCallback((item: MenuItem, deliveryFee: number) => {
  36:     setCart((current) => {
  37:       if (!current.restaurantId || current.restaurantId !== item.restaurant_id) {
  38:         return { restaurantId: item.restaurant_id, lines: [{ item, quantity: 1, deliveryFee }] };
  39:       }
  40:       const lines = current.lines.map((line) =>
  41:         line.item.id === item.id ? { ...line, quantity: line.quantity + 1 } : line,
  42:       );
  43:       if (!lines.some((line) => line.item.id === item.id)) {
  44:       lines.push({ item, quantity: 1, deliveryFee });
  45:       }
  46:       return { ...current, lines };
  47:     });
  48:   }, []);
  49: 
  50:   const change = useCallback((itemId: number, delta: number) => {
  51:     setCart((current) => {
  52:       const lines = current.lines
  53:         .map((line) => line.item.id === itemId ? { ...line, quantity: line.quantity + delta } : line)
  54:         .filter((line) => line.quantity > 0);
  55:       return lines.length ? { ...current, lines } : { restaurantId: null, lines: [] };
  56:     });
  57:   }, []);
  58: 
  59:   const clear = useCallback(() => setCart({ restaurantId: null, lines: [] }), []);
  60: 
  61:   const value = useMemo<CartState>(() => {
  62:     const subtotal = cart.lines.reduce((sum, line) => sum + line.item.price * line.quantity, 0);
  63:     return {
  64:       lines: cart.lines,
  65:       restaurantId: cart.restaurantId,
  66:       subtotal,
  67:       add,
  68:       change,
  69:       clear,
  70:     };
  71:   }, [add, cart, change, clear]);
  72: 
  73:   return <CartContext.Provider value={value}>{children}</CartContext.Provider>;
  74: }
  75: 
  76: export function useCart() {
  77:   const context = useContext(CartContext);
  78:   if (!context) throw new Error("useCart CartProvider icinde kullanilmali");
  79:   return context;
  80: }

