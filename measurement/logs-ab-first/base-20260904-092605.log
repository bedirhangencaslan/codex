   6: def _user_from_token(conn, token: str | None):
   7:     if not token or not token.startswith("Bearer "):
   8:         return None
   9:     value = token.removeprefix("Bearer ")
  10:     return conn.execute(
  11:         """SELECT u.id, u.email, u.role, u.balance
  12:            FROM auth_token t JOIN "user" u ON u.id = t.user_id
  13:            WHERE t.token = ?""",
  14:         (value,),
  15:     ).fetchone()
  16: 
  17: 
  18: def resolve_user(authorization: str | None = Header(default=None)):
  19:     with get_db() as conn:
  20:         return _user_from_token(conn, authorization)
  21: 
  22: 
  23: def get_current_user(user=Depends(resolve_user)):
  24:     if not user:
  25:         raise HTTPException(status_code=401, detail="Giris yapmalisiniz")
  26:     return user
  27: 
  28: 
  29: def get_optional_user(user=Depends(resolve_user)):
  30:     return user
