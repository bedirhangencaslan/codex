128:@router.post("/restaurant/couriers", status_code=201)
129:def create_courier(payload: CourierInput, user_restaurant=Depends(require_restaurant)) -> dict:
130:    _, restaurant = user_restaurant
131:    if not payload.name.strip():
132:        raise HTTPException(status_code=400, detail="Kurye adi zorunludur")
133:    with get_db() as conn:
134:        if conn.execute('SELECT 1 FROM "user" WHERE email = ?', (payload.email,)).fetchone():
135:            raise HTTPException(status_code=409, detail="Bu e-posta zaten kayitli")
136:        cursor = conn.execute(
137:            'INSERT INTO "user" (email, password_hash, role) VALUES (?, ?, ?)',
138:            (payload.email, hash_password(payload.password), "courier"),
139:        )
140:        courier_id = cursor.lastrowid
141:        conn.execute(
142:            "INSERT INTO courier (user_id, restaurant_id, name) VALUES (?, ?, ?)",
143:            (courier_id, restaurant["id"], payload.name),
144:        )
145:    return {"id": courier_id, "name": payload.name, "restaurant_id": restaurant["id"]}
