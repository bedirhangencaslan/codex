6:def _user_from_token(conn, token: str | None):
7:    if not token or not token.startswith("Bearer "):
8:        return None
9:    value = token.removeprefix("Bearer ")
10:    return conn.execute(
11:        """SELECT u.id, u.email, u.role, u.balance
12:           FROM auth_token t JOIN "user" u ON u.id = t.user_id
13:           WHERE t.token = ?""",
14:        (value,),
15:    ).fetchone()
