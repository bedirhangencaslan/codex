87:    user_restaurant=Depends(require_restaurant),
88:) -> list[dict[str, Any]]:
89:    _, restaurant = user_restaurant
90:    query = """SELECT o.*, r.name AS restaurant_name,
91:                      u.email AS customer_email, c.name AS courier_name
92:               FROM "order" o
93:               JOIN restaurant r ON r.id = o.restaurant_id
94:               LEFT JOIN "user" u ON u.id = o.customer_id
95:               LEFT JOIN courier c ON c.id = o.courier_id
96:               WHERE o.restaurant_id = ?"""
97:    params: list[Any] = [restaurant["id"]]
98:    if status:
99:        query += " AND o.status = ?"
100:        params.append(status)
101:    with get_db() as conn:
102:        rows = conn.execute(query + " ORDER BY o.created_at DESC", params).fetchall()
103:    return serialize_orders(conn, rows)
