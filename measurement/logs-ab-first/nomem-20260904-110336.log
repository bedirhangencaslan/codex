  21: def hash_password(password: str) -> str:
  22:     salt = secrets.token_hex(16)
  23:     digest = hashlib.pbkdf2_hmac("sha256", password.encode(), salt.encode(), 120000)
  24:     return f"{salt}${digest.hex()}"
  25: 
  26: 
  27: def verify_password(password: str, stored: str) -> bool:
  28:     try:
  29:         salt, expected = stored.split("$", 1)
  30:         digest = hashlib.pbkdf2_hmac("sha256", password.encode(), salt.encode(), 120000)
  31:         return secrets.compare_digest(digest.hex(), expected)
  32:     except ValueError:
  33:         return False

