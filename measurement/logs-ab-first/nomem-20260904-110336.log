 166:     _, restaurant = user_restaurant
 167:     now = utc_now()
 168:     with get_db() as conn:
 169:         order = conn.execute(
 170:             'SELECT * FROM "order" WHERE id = ?', (order_id,)
 171:         ).fetchone()
 172:         if not order or order["restaurant_id"] != restaurant["id"]:
 173:             raise HTTPException(status_code=404, detail="Siparis bulunamadi")
 174:         if order["status"] != "hazÄ±rlanÄ±yor":
 175:             raise HTTPException(status_code=409, detail="Bu siparis icin kurye atanamaz")
 176:         courier = conn.execute(
 177:             "SELECT * FROM courier WHERE id = ? AND restaurant_id = ?",
 178:             (payload.courier_id, restaurant["id"]),
 179:         ).fetchone()
 180:         if not courier:
 181:             raise HTTPException(status_code=403, detail="Kurye bu restorana ait degil")
 182:         conn.execute(
 183:             """UPDATE "order" SET courier_id = ?, courier_assigned_at = ?, status = 'kuryede'
 184:                WHERE id = ?""",
 185:             (courier["id"], now, order_id),
 186:         )
 187:     return {"status": "kuryede", "courier_name": courier["name"]}
 188: 
 189: 
 190: @router.get("/courier/orders")
 191: def courier_orders(courier_data=Depends(require_courier)) -> list[dict[str, Any]]:
 192:     _, courier = courier_data
 193:     with get_db() as conn:
 194:         rows = conn.execute(
 195:             """SELECT o.*, r.name AS restaurant_name,
 196:                       u.email AS customer_email, c.name AS courier_name
 197:                FROM "order" o
 198:                JOIN restaurant r ON r.id = o.restaurant_id
 199:                LEFT JOIN "user" u ON u.id = o.customer_id
 200:                JOIN courier c ON c.id = o.courier_id
 201:                WHERE o.courier_id = ? ORDER BY o.created_at DESC""",
 202:             (courier["id"],),
 203:         ).fetchall()
 204:     return serialize_orders(conn, rows)
