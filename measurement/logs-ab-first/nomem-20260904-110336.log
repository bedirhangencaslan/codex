 232:         ).fetchone()
 233:         if not order or order["customer_id"] != user["id"]:
 234:             raise HTTPException(status_code=404, detail="Siparis bulunamadi")
 235:         if order["status"] != "teslim_edildi":
 236:             raise HTTPException(status_code=409, detail="Bu siparis onaylanamaz")
 237:         conn.execute(
 238:             """UPDATE "order" SET status = 'onaylandÄ±', confirmed_at = ? WHERE id = ?""",
 239:             (now, order_id),
