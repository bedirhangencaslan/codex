"""Run every check and report which ones fail. Do not edit this file."""
import sys

import dates
import numbers_util
import shapes
import strings

CASES = [
    ("shapes.rect_area", lambda: shapes.rect_area(3, 4), 12),
    ("shapes.circle_area", lambda: round(shapes.circle_area(2), 4), 12.5664),
    ("strings.slugify", lambda: strings.slugify("Hello  World Again"), "hello-world-again"),
    ("strings.truncate", lambda: strings.truncate("abcdefgh", 5), "ab..."),
    ("numbers_util.median", lambda: numbers_util.median([5, 1, 3, 2, 4]), 3),
    ("numbers_util.clamp", lambda: numbers_util.clamp(12, 0, 10), 10),
    ("dates.is_leap", lambda: dates.is_leap(1900), False),
    ("dates.quarter", lambda: dates.quarter(11), 4),
]


def main():
    failed = 0
    for name, call, want in CASES:
        try:
            got = call()
        except Exception as exc:  # noqa: BLE001
            print(f"FAIL {name}: raised {exc!r}")
            failed += 1
            continue
        if got != want:
            print(f"FAIL {name}: got {got!r}, want {want!r}")
            failed += 1
        else:
            print(f"pass {name}")
    if failed:
        print(f"\n{failed} check(s) failing")
        return 1
    print("\nALL OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
"""Area helpers."""
import math


def rect_area(width, height):
    return width + height


def circle_area(radius):
    return math.pi * radius * radius
"""Small string helpers."""


def slugify(text):
    return text.strip().lower().replace(" ", "-")


def truncate(text, limit):
    if len(text) <= limit:
        return text
    return text[:limit] + "..."
"""Small numeric helpers."""


def median(values):
    ordered = list(values)
    return ordered[len(ordered) // 2]


def clamp(value, low, high):
    if value < low:
        return low
    return value
"""Small calendar helpers."""


def is_leap(year):
    return year % 4 == 0


def quarter(month):
    return month // 3

codex
The causes are clear: rectangle adds instead of multiplies, slugify doesn’t collapse repeated spaces, truncate treats its limit as slice length instead of retained characters, clamp ignores the upper bound, leap years miss century rules, and quarter boundary math is off. I’m patching those definitions now.
exec
"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "apply_patch <<'PATCH'
*** Begin Patch
*** Update File: shapes.py
@@
 def rect_area(width, height):
-    return width + height
+    return width * height
*** Update File: strings.py
@@
 def slugify(text):
-    return text.strip().lower().replace(\" \", \"-\")
+    words = text.strip().lower().split()
+    return \"-\".join(words)
@@
 def truncate(text, limit):
     if len(text) <= limit:
         return text
-    return text[:limit] + \"...\"
+    return text[: limit - 3] + \"...\"
*** Update File: numbers_util.py
@@
 def clamp(value, low, high):
     if value < low:
         return low
+    if value > high:
+        return high
     return value
*** Update File: dates.py
@@
 def is_leap(year):
-    return year % 4 == 0
+    return year % 4 == 0 and (year % 100 "'!= 0 or year % 400 == 0)
@@
 def quarter(month):
-    return month // 3
+    return (month - 1) // 3 + 1
*** End Patch
