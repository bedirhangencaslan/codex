) -> RealtimeOutboundMessage {
    RealtimeOutboundMessage::ConversationItemCreate {
        item: ConversationItemPayload::FunctionCallOutput(ConversationFunctionCallOutputItem {
            r#type: ConversationItemType::FunctionCallOutput,
            call_id,
            output: output_text,
        }),
    }
}

