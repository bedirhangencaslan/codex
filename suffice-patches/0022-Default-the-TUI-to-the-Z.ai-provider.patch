 ) -> Config {
+    let provider_overridden = overrides.model_provider.is_some();
     #[allow(clippy::print_stderr)]
     match ConfigBuilder::default()
         .cli_overrides(cli_kv_overrides)
@@ -1864,7 +1866,12 @@ async fn load_config_or_exit_with_fallback_cwd(
         .build()
