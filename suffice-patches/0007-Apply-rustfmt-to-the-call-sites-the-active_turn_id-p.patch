-    assert!(request
-        .input
-        .iter()
-        .any(|item| matches!(item, ResponseItem::Reasoning { .. })));
-    assert!(request
-        .input
-        .iter()
-        .any(|item| matches!(item, ResponseItem::Message { .. })));
+    assert!(
+        request
+            .input
+            .iter()
+            .any(|item| matches!(item, ResponseItem::Reasoning { .. }))
+    );
+    assert!(
+        request
+            .input
