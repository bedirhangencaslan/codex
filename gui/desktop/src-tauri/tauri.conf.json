{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Suffice",
  "version": "0.1.0",
  "identifier": "dev.suffice.gui",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:7877",
    "beforeDevCommand": "pnpm --filter @suffice/gui-web dev",
    "beforeBuildCommand": "pnpm --filter @suffice/gui-web build"
  },
  "app": {
    "windows": [
      {
        "title": "Suffice",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws://127.0.0.1:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": false
  }
}
