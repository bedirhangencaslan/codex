{
  "name": "suffice-gui",
  "displayName": "Suffice GUI",
  "description": "Suffice oturum, beceri ve komut panelini VS Code içinde açar",
  "version": "0.1.0",
  "private": true,
  "publisher": "suffice",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "suffice.openGui",
        "title": "Suffice: Open GUI"
      }
    ]
  },
  "scripts": {
    "sync-dist": "rm -rf media && cp -R ../web/dist media",
    "compile": "tsc -p .",
    "build": "pnpm sync-dist && pnpm compile"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.3"
  }
}
